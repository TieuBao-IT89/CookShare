@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var following = controller == "Home" && (action == "Following" || Context.Request.Query["feed"] == "following");
    var home = controller == "Home" && action == "Index" && !following;
    var publishing = (controller == "Recipe" || controller == "CookedPosts") && (action == "Create" || action == "Edit");
    var explore = controller == "Recipe" && action != "Saved" && !publishing;
    var saved = (controller == "Recipe" && action == "Saved") || controller == "Collections";
    var profile = controller == "Profile";
}
<header class="site-header">
    <div class="container nav">
        <a class="logo" asp-controller="Home" asp-action="Index" aria-label="CookShare — Trang chủ">
            <span class="logo-mark"><svg class="icon"><use href="#i-chef" /></svg></span>
            <span>Cook<span class="brand-accent">Share</span><span class="brand-dot">.</span></span>
        </a>
        <button type="button" class="menu-btn icon-button" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="primaryNav"><i class="icon fa-solid fa-bars" aria-hidden="true"></i></button>
        <nav class="nav-links" id="primaryNav" aria-label="Điều hướng chính">
            <a class="@(home || following ? "active" : "")" aria-current="@(home ? "page" : null)" asp-controller="Home" asp-action="Index">Bảng tin</a>
            <a class="@(explore ? "active" : "")" aria-current="@(explore ? "page" : null)" asp-controller="Recipe" asp-action="Index">Khám phá</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="@(following ? "active" : "")" aria-current="@(following ? "page" : null)" asp-controller="Home" asp-action="Following">Đang theo dõi</a>
            }
            else
            {
                <a href="@Url.Action("Index", "Home")#categories">Danh mục</a>
            }
            <a class="@(saved ? "active" : "")" aria-current="@(saved ? "page" : null)" asp-controller="Recipe" asp-action="Saved">Đã lưu</a>
            <div class="mobile-nav-actions">
                <a asp-controller="Recipe" asp-action="Create"><i class="icon fa-solid fa-plus" aria-hidden="true"></i> Chia sẻ công thức</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index">Trang cá nhân</a>
                    <a asp-controller="Notifications" asp-action="Index">Thông báo</a>
                    @if (User.IsInRole("Moderator")) { <a asp-controller="Moderation" asp-action="Index">Kiểm duyệt nội dung</a> }
                    <a class="login account-name" asp-controller="Account" asp-action="Settings" title="Cài đặt tài khoản">@User.Identity?.Name</a>
                    <form class="logout-form" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                }
            </div>
        </nav>
        <div class="nav-actions">
            <form class="header-search" asp-controller="Recipe" asp-action="Index" method="get" role="search">
                <label class="sr-only" for="headerGlobalSearch">Tìm tên món ăn hoặc câu chuyện</label>
                <input id="headerGlobalSearch" name="q" type="search" placeholder="Hôm nay nấu món gì?" value="@Context.Request.Query["q"]" />
                <button type="submit" aria-label="Tìm kiếm"><i class="icon fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
            </form>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @await Component.InvokeAsync("NotificationBadge")
                <details class="header-account" data-account-menu>
                    <summary class="icon-button"><i class="icon fa-regular fa-user" aria-hidden="true"></i><span class="sr-only">Tài khoản @User.Identity?.Name</span></summary>
                    <div class="header-account-menu">
                        <span class="header-account-name">@User.Identity?.Name</span>
                        <a asp-controller="Profile" asp-action="Index">Căn bếp của tôi</a>
                        <a asp-controller="Account" asp-action="Settings">Cài đặt tài khoản</a>
                        @if (User.IsInRole("Moderator")) { <a asp-controller="Moderation" asp-action="Index">Kiểm duyệt nội dung</a> }
                        <form class="logout-form" asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit">Đăng xuất</button></form>
                    </div>
                </details>
            }
            else
            {
                <a class="login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="login" asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
            <a class="btn btn-small publish-link" asp-controller="Recipe" asp-action="Create"><i class="icon fa-solid fa-plus" aria-hidden="true"></i> Đăng món</a>
        </div>
    </div>
</header>
<nav class="mobile-bottom-nav" aria-label="Điều hướng nhanh">
    <a class="@(home || following ? "is-active" : "")" aria-current="@(home || following ? "page" : null)" asp-controller="Home" asp-action="Index"><i class="icon fa-solid fa-house" aria-hidden="true"></i><span>Bảng tin</span></a>
    <a class="@(explore ? "is-active" : "")" aria-current="@(explore ? "page" : null)" asp-controller="Recipe" asp-action="Index"><i class="icon fa-solid fa-compass" aria-hidden="true"></i><span>Khám phá</span></a>
    <a class="mobile-publish @(publishing ? "is-active" : "")" aria-current="@(publishing ? "page" : null)" asp-controller="Recipe" asp-action="Create"><i class="icon fa-solid fa-plus" aria-hidden="true"></i><span>Đăng</span></a>
    <a class="@(saved ? "is-active" : "")" aria-current="@(saved ? "page" : null)" asp-controller="Recipe" asp-action="Saved"><i class="icon fa-regular fa-bookmark" aria-hidden="true"></i><span>Đã lưu</span></a>
    <a class="@(profile ? "is-active" : "")" aria-current="@(profile ? "page" : null)" asp-controller="Profile" asp-action="Index"><i class="icon fa-regular fa-user" aria-hidden="true"></i><span>Hồ sơ</span></a>
</nav>
