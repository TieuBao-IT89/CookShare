@model CookShare.ViewModels.RecipeCommentViewModel
@using CookShare.Helpers
@{
  var nameParts = Model.AuthorName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
  var initials = string.Concat(nameParts.TakeLast(2).Select(part => part[..1].ToUpperInvariant()));
}
<article class="comment-item @(Model.CanManage ? "comment-item--own" : "")" id="comment-@Model.Id" data-db-comment data-comment-id="@Model.Id">
  <div class="comment-avatar comment-avatar--small" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl) && RecipeImageReference.IsValid(Model.AvatarUrl))
    {
      <img src="@RecipeImageReference.GetSource(Model.AvatarUrl)" alt="" width="36" height="36" loading="lazy" />
    }
    else
    {
      @(string.IsNullOrEmpty(initials) ? "?" : initials)
    }
  </div>
  <div class="comment-body">
    <div class="comment-header-row">
      <a class="comment-author-name" asp-controller="Profile" asp-action="Index" asp-route-userId="@Model.UserId">@Model.AuthorName</a>
      <time class="comment-timestamp" datetime="@Model.CreatedAt.ToString("O")">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</time>
    </div>
    <p class="comment-content-text">@Model.Content</p>
    @if (Model.CanManage)
    {
      <div class="comment-actions-row">
        <button type="button" class="btn-comment-action btn-comment-edit" data-comment-edit aria-label="Sửa bình luận của @Model.AuthorName">✎ Sửa</button>
        <button type="button" class="btn-comment-action btn-comment-delete" data-comment-delete aria-label="Xóa bình luận của @Model.AuthorName">🗑 Xóa</button>
      </div>
    }
  </div>
</article>
