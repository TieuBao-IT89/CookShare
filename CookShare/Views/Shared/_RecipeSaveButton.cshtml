@model CookShare.Models.Recipe
@using System.Security.Claims
@{
  var savedIds = ViewData["SavedRecipeIds"] as IReadOnlySet<int>;
  var saved = savedIds?.Contains(Model.Id) == true;
  var buttonClass = ViewData["SaveButtonClass"] as string ?? "card-save";
  var isUnsaveButton = buttonClass == "saved-card-unsave-btn";
  var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
  var loginUrl = Url.Action("Login", "Account", new { returnUrl });
  var saveUrl = Url.Content($"~/Recipe/{Model.Id}/Favorites");
  var unsaveUrl = Url.Content($"~/Recipe/{Model.Id}/Favorites/Unsave");
  var stateUrl = Url.Action("State", "RecipeFavorites");
  var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
  var label = $"{(saved ? "Bỏ lưu" : "Lưu")} {Model.Name}";
}
<div class="db-recipe-save" data-db-save-control>
  @if (User.Identity?.IsAuthenticated == true)
  {
    <form action="@(saved ? unsaveUrl : saveUrl)" method="post" asp-antiforgery="false" data-db-save-form>
      @Html.AntiForgeryToken()
      <button type="submit" class="recipe-save-btn @buttonClass @(saved ? "saved" : "")"
              data-db-recipe-save data-recipe-id="@Model.Id" data-recipe-name="@Model.Name"
              data-is-saved="@saved.ToString().ToLowerInvariant()" data-saved-user-id="@userId"
              data-save-url="@saveUrl" data-unsave-url="@unsaveUrl" data-state-url="@stateUrl" data-login-url="@loginUrl"
              aria-pressed="@saved.ToString().ToLowerInvariant()" aria-label="@label" title="@label">
        <span class="save-icon"><svg class="icon" aria-hidden="true"><use href="#i-bookmark" /></svg></span>
        @if (buttonClass != "card-save")
        {
          <span class="save-text">@(isUnsaveButton ? "Bỏ lưu công thức" : saved ? "Đã lưu" : "Lưu")</span>
        }
      </button>
    </form>
  }
  else
  {
    <a class="recipe-save-btn @buttonClass" href="@loginUrl"
       data-db-recipe-save data-recipe-id="@Model.Id" data-is-saved="false"
       data-saved-user-id="" data-login-url="@loginUrl" aria-label="Đăng nhập để lưu @Model.Name" title="Đăng nhập để lưu công thức">
      <span class="save-icon"><svg class="icon" aria-hidden="true"><use href="#i-bookmark" /></svg></span>
      @if (buttonClass != "card-save")
      {
        <span class="save-text">Lưu</span>
      }
    </a>
  }
  <p data-save-status role="status" aria-live="polite" hidden></p>
</div>
