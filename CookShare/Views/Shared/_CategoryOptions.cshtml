@model CookShare.ViewModels.RecipeFormViewModel
@{
    var selected = Model?.Category ?? string.Empty;
    var categories = new[]
    {
        "Món Việt",
        "Món Á",
        "Món Âu",
        "Món chính",
        "Món phụ",
        "Món chay",
        "Món tráng miệng",
        "Đồ uống",
        "Ăn sáng"
    };
}
<!option value="">Chọn danh mục món ăn</!option>
@foreach (var category in categories)
{
    if (category == selected)
    {
        <!option value="@category" selected>@category</!option>
    }
    else
    {
        <!option value="@category">@category</!option>
    }
}
