@{
    var selectedCategory = (ViewData.Model as CookShare.ViewModels.RecipeFormViewModel)?.Category;
    var categories = new[]
    {
        "Món Việt", "Món Á", "Món Âu", "Món chính", "Món phụ",
        "Món chay", "Món tráng miệng", "Đồ uống", "Ăn sáng"
    };
}

<option value="">@(ViewData["IsEditing"] is bool ? "Chọn danh mục món ăn" : "Tất cả danh mục")</option>
@if (!string.IsNullOrEmpty(selectedCategory) && !categories.Contains(selectedCategory))
{
    <option value="@selectedCategory" selected>@selectedCategory</option>
}
@foreach (var category in categories)
{
    <option value="@category" selected="@(category == selectedCategory)">@category</option>
}
