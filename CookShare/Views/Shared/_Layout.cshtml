<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CookShare — khám phá món ngon, chia sẻ công thức và tìm cảm hứng cho căn bếp của bạn." />
    <meta name="theme-color" content="#245c43" />
    <title>@ViewData["Title"] · CookShare</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
          integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    <partial name="_Icons" />
    <partial name="_RecipeHeader" />
    <main id="main-content" tabindex="-1">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="notice container status-banner" role="status">@statusMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="notice container status-banner text-danger" role="alert">@errorMessage</div>
        }
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="container footer-content">
            <div class="footer-brand">
                <a class="logo" asp-controller="Home" asp-action="Index" aria-label="CookShare — Trang chủ">
                    <span class="logo-mark"><svg class="icon"><use href="#i-chef" /></svg></span>
                    <span>Cook<span class="brand-accent">Share</span><span class="brand-dot">.</span></span>
                </a>
                <p>Mỗi công thức là một câu chuyện.<br />Cùng nhau làm cho căn bếp thêm ấm áp.</p>
                <span class="footer-note">Nấu bằng đam mê. Chia sẻ bằng cả trái tim.</span>
            </div>
            <div class="footer-links">
                <h2>Khám phá</h2>
                <a asp-controller="Recipe" asp-action="Index">Tất cả công thức</a>
                <a href="@Url.Action("Index", "Home")#categories">Danh mục món ăn</a>
                <a asp-controller="Recipe" asp-action="Saved">Công thức đã lưu</a>
            </div>
            <div class="footer-links">
                <h2>Cùng CookShare</h2>
                <a asp-controller="Recipe" asp-action="Create">Chia sẻ công thức</a>
                <a asp-controller="Profile" asp-action="Index">Trang cá nhân</a>
                <a asp-controller="Home" asp-action="Register">Tham gia cộng đồng</a>
            </div>
            <div class="footer-kitchen"><i class="icon fa-regular fa-heart" aria-hidden="true"></i><p>Món ngon hơn<br />khi được sẻ chia.</p></div>
        </div>
        <div class="container footer-bottom">
            <span>© @DateTime.Now.Year CookShare. Cộng đồng yêu bếp.</span>
            <span>Một chút cảm hứng cho bữa cơm mỗi ngày <i class="icon fa-solid fa-leaf" aria-hidden="true"></i></span>
        </div>
    </footer>
    <partial name="_RecipeCardTemplate" />
    <div id="uiToast" class="ui-toast" role="status" aria-live="polite" hidden></div>
    <dialog id="confirmDialog" class="confirm-dialog" aria-labelledby="confirmTitle" aria-describedby="confirmMessage">
        <form method="dialog" asp-antiforgery="false">
            <span class="state-icon danger"><i class="icon fa-regular fa-trash-can" aria-hidden="true"></i></span>
            <h2 id="confirmTitle">Xóa công thức?</h2><p id="confirmMessage"></p>
            <div class="dialog-actions">
                <button class="btn btn-secondary" value="cancel" autofocus>Giữ lại</button>
                <button class="btn btn-danger" value="confirm">Xóa công thức</button>
            </div>
        </form>
    </dialog>
    <noscript><div class="notice container">Một số tương tác giao diện cần JavaScript. Bạn vẫn có thể xem và gửi biểu mẫu công thức.</div></noscript>
    <script src="~/js/style.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
