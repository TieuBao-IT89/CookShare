@model CookShare.ViewModels.RecipeLikeViewModel
@{
  var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
  var loginUrl = Url.Action("Login", "Account", new { returnUrl });
  var likeUrl = Url.Content($"~/Recipe/{Model.RecipeId}/Likes");
  var unlikeUrl = Url.Content($"~/Recipe/{Model.RecipeId}/Likes/Unlike");
  var label = Model.IsLiked ? "Bỏ thích công thức" : "Thích công thức";
}
<div class="db-recipe-like" data-db-recipe-like data-recipe-id="@Model.RecipeId" data-is-liked="@Model.IsLiked.ToString().ToLowerInvariant()" data-like-url="@likeUrl" data-unlike-url="@unlikeUrl" data-login-url="@loginUrl">
  @if (User.Identity?.IsAuthenticated == true)
  {
    <form action="@(Model.IsLiked ? unlikeUrl : likeUrl)" method="post" asp-antiforgery="false" data-db-like-form>
      @Html.AntiForgeryToken()
      <button type="submit" class="recipe-like-btn btn-details-like @(Model.IsLiked ? "liked" : "")" aria-pressed="@Model.IsLiked.ToString().ToLowerInvariant()" aria-label="@label">
        <span class="like-icon" aria-hidden="true">@(Model.IsLiked ? "♥" : "♡")</span>
        <span class="like-text">@(Model.IsLiked ? "Đã thích" : "Thích")</span>
        <span class="like-count-pill recipe-like-count-display" data-db-like-count>@Model.LikeCount</span>
      </button>
    </form>
  }
  else
  {
    <a class="recipe-like-btn btn-details-like" href="@loginUrl" aria-label="Đăng nhập để thích công thức">
      <span class="like-icon" aria-hidden="true">♡</span>
      <span class="like-text">Thích</span>
      <span class="like-count-pill recipe-like-count-display" data-db-like-count>@Model.LikeCount</span>
    </a>
  }
  <p class="db-interaction-status" data-like-status role="status" aria-live="polite" hidden></p>
</div>
