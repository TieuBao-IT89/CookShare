
@model CookShare.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/edit-profile.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/creator-profile.css" asp-append-version="true" />
}

<section class="auth-page container">
    <div class="auth-shell">

        <partial name="_AuthAside" />

        <div class="auth-form-area">

            <a class="back-link"
               asp-controller="Profile"
               asp-action="Index">
                ← Quay lại trang cá nhân
            </a>

            <span class="eyebrow">
                THÔNG TIN CÁ NHÂN
            </span>

            <h1>Chỉnh sửa <em>hồ sơ.</em></h1>

            <p class="auth-subtitle">
                Cập nhật thông tin của bạn trên CookShare.
            </p>

            <form asp-controller="Profile"
                  asp-action="Edit"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger"
                     role="alert"></div>

                <div class="form-field-group">
                    <label asp-for="DisplayName"
                           class="form-label">
                        Tên hiển thị
                    </label>

                    <input asp-for="DisplayName"
                           class="form-input"
                           autocomplete="name" />

                    <span asp-validation-for="DisplayName"
                          class="text-danger"></span>
                </div>

                <div class="form-field-group">
                    <label asp-for="AvatarUrl"
                           class="form-label">
                        Đường dẫn ảnh đại diện
                    </label>

                    <input asp-for="AvatarUrl"
                           class="form-input"
                           id="avatarUrlInput"
                           placeholder="/img/recipes/profile-avatar.webp" />

                    <img class="profile-preview-avatar" id="avatarPreview" alt="Xem trước ảnh đại diện" width="96" height="96" />

                    <span asp-validation-for="AvatarUrl"
                          class="text-danger"></span>
                </div>

                <div class="form-field-group">
                    <label asp-for="CoverImageUrl" class="form-label">Đường dẫn ảnh bìa</label>
                    <input asp-for="CoverImageUrl" class="form-input" id="coverUrlInput" placeholder="https://images.example/cover.jpg" />
                    <img class="profile-preview-cover" id="coverPreview" alt="Xem trước ảnh bìa" />
                    <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                </div>

                <div class="form-field-group">
                    <label asp-for="Bio" class="form-label">Tiểu sử</label>
                    <textarea asp-for="Bio" class="form-input" id="profileBio" maxlength="300" rows="4"
                              placeholder="Yêu thích nấu ăn và khám phá những món ngon Việt Nam."></textarea>
                    <span class="profile-char-count" id="profileBioCount" aria-live="polite">0 / 300</span>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <div class="profile-edit-actions">
                    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
                    <button type="submit" class="btn">Lưu thay đổi</button>
                </div>
            </form>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/creator-profile.js" asp-append-version="true"></script>
}
