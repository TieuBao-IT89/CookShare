@model CookShare.ViewModels.ProfileViewModel
@using CookShare.Helpers

@{
    ViewData["Title"] = $"Trang cá nhân - {Model.DisplayName}";

    var avatar = string.IsNullOrWhiteSpace(Model.AvatarUrl) || !RecipeImageReference.IsValid(Model.AvatarUrl)
        ? Url.Content("~/img/recipes/profile-avatar.webp")
        : RecipeImageReference.GetSource(Model.AvatarUrl);
    var cover = string.IsNullOrWhiteSpace(Model.CoverImageUrl) || !RecipeImageReference.IsValid(Model.CoverImageUrl)
        ? null
        : RecipeImageReference.GetSource(Model.CoverImageUrl);
    var avatarFallback = Url.Content("~/img/recipes/profile-avatar.webp");
    var pickerRecipes = Model.FeaturedRecipes
        .Concat(Model.Recipes.Where(recipe => Model.FeaturedRecipes.All(pinned => pinned.Id != recipe.Id)))
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/recipe-saved.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-interactions.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/recipe.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/user-follow.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/edit-profile.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/creator-profile.css" asp-append-version="true" />
}

<section class="profile-page">
    <div class="container">

        <div class="profile-cover @(cover == null ? "is-fallback" : "")" id="profileCover">
            @if (cover != null)
            {
                <img class="profile-cover-image" src="@cover" alt="" data-cover-image />
            }
            <span class="profile-cover-fallback">the joy of home cooking.</span>
            @if (Model.IsOwner)
            {
                <a class="profile-cover-edit" asp-action="Edit">Đổi ảnh bìa</a>
            }
        </div>

        <header class="profile-header">

            <img class="profile-avatar"
                 src="@avatar"
                 alt="Ảnh đại diện @Model.DisplayName"
                 width="120"
                 height="120"
                 data-avatar-fallback="@avatarFallback" />

            <div class="profile-main">

                <span class="eyebrow">
                    MỘT NGƯỜI BẠN YÊU BẾP
                </span>

                <div class="profile-name-row">
                    <h1>
                        <span class="profile-name">
                            @Model.DisplayName
                        </span>
                    </h1>
                </div>

                <p class="profile-username">
                    @("@" + Model.UserName)
                </p>

                @if (string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="profile-bio is-placeholder">
                        @(Model.IsOwner
                            ? "Hãy chia sẻ một chút về căn bếp của bạn."
                            : "Người dùng này chưa viết tiểu sử.")
                    </p>
                }
                else
                {
                    <p class="profile-bio">@Model.Bio</p>
                }

                <p class="profile-joined">
                    Thành viên CookShare từ
                    @Model.JoinedAt.ToString("dd/MM/yyyy")
                </p>

                <div class="profile-stats">

                    <span class="stat">
                        <strong>@Model.FollowersCount</strong>
                        người theo dõi
                    </span>

                    <span class="stat">
                        <strong>@Model.FollowingCount</strong>
                        đang theo dõi
                    </span>

                    <span class="stat">
                        <strong id="profileRecipeCount">
                            @Model.RecipeCount
                        </strong>
                        công thức
                    </span>

                </div>
            </div>

            <div class="profile-actions">
            @if (Model.IsOwner)
            {
                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="btn btn-secondary">
                    Chỉnh sửa hồ sơ
                </a>

                <a asp-controller="Recipe"
                   asp-action="Create"
                   class="btn">
                    Chia sẻ món mới
                </a>

                <button type="button" class="btn btn-secondary" data-open-highlights>
                    Quản lý công thức nổi bật
                </button>
            }
            else
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Profile"
                          asp-action="@(Model.IsFollowing ? "Unfollow" : "Follow")"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.UserId" />
                        <button type="submit"
                                class="btn-follow-action @(Model.IsFollowing ? "is-following" : "")">
                            @(Model.IsFollowing ? "Bỏ theo dõi" : "Theo dõi")
                        </button>
                    </form>
                }

                <a class="btn btn-secondary" href="#recipes">Xem công thức</a>
                <a class="btn btn-secondary" href="#followers">Người theo dõi</a>
                <a class="btn btn-secondary" href="#following">Đang theo dõi</a>
            }
            </div>

        </header>

        @if (TempData["Success"] != null)
        {
            <p class="notice" role="status">
                @TempData["Success"]
            </p>
        }
        @if (TempData["Error"] != null)
        {
            <p class="notice error" role="alert">
                @TempData["Error"]
            </p>
        }

        @if (Model.IsOwner || Model.FeaturedRecipes.Count > 0)
        {
            <section id="highlights" class="creator-highlights" aria-labelledby="highlightHeading">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">CÔNG THỨC TIÊU BIỂU</span>
                        <h2 id="highlightHeading">Công thức nổi bật</h2>
                    </div>
                    @if (Model.IsOwner)
                    {
                        <button type="button" class="text-link" data-open-highlights>Quản lý công thức nổi bật</button>
                    }
                </div>
                @if (Model.FeaturedRecipes.Count == 0)
                {
                    <p class="discovery-empty" id="highlightEmpty">Chọn công thức nổi bật để giới thiệu căn bếp của bạn.</p>
                }
                else
                {
                    <div class="recipe-grid featured-grid">
                        @foreach (var recipe in Model.FeaturedRecipes)
                        {
                            <div class="featured-recipe">
                                <span class="featured-badge">Nổi bật</span>
                                <partial name="_RecipeCard" model="recipe" />
                            </div>
                        }
                    </div>
                }
            </section>
        }

        <nav class="profile-tabs"
             aria-label="Nội dung trang cá nhân">

            <div class="profile-tab-list" role="tablist">
                @if (Model.IsOwner || Model.FeaturedRecipes.Count > 0)
                {
                    <a class="profile-tab" href="#highlights">Nổi bật</a>
                }
                <a class="profile-tab active"
                   href="#recipes">
                    Góc công thức
                </a>

                <a class="profile-tab"
                   href="#followers">
                    Người theo dõi
                </a>

                <a class="profile-tab"
                   href="#following">
                    Đang theo dõi
                </a>

                @if (Model.IsOwner)
                {
                    <a class="profile-tab"
                       href="#favorites">
                        Đã lưu
                    </a>
                }
            </div>
        </nav>

        <section id="recipes">
            <div class="section-heading profile-section-heading">
                <div>
                    <span class="eyebrow">
                        MÓN NGON TỪ CĂN BẾP NHỎ
                    </span>

                    <h2>Góc công thức</h2>

                    <p>
                        Những công thức được chia sẻ bởi
                        @Model.DisplayName.
                    </p>
                </div>
            </div>

            @if (Model.Recipes.Count == 0)
            {
                <div class="recipe-empty-container">
                    <h3>Chưa có công thức nào</h3>
                    <p>
                        Những món ngon được chia sẻ sẽ xuất hiện ở đây.
                    </p>
                </div>
            }
            else
            {
                <div class="recipe-grid profile-recipe-grid">

                    @foreach (var recipe in Model.Recipes)
                    {
                        <partial name="_RecipeCard" model="recipe" />
                    }

                </div>
            }
        </section>

        <section id="followers"
                 class="profile-connections-section">
            <h2>Người theo dõi (@Model.FollowersCount)</h2>

            @if (Model.Followers.Count == 0)
            {
                <p>Chưa có người theo dõi.</p>
            }
            else
            {
                <div class="profile-user-list">
                    @foreach (var follower in Model.Followers)
                    {
                        <div class="user-card">
                            <div class="user-card-info">
                                <h3>
                                    <a asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-userId="@follower.UserId">
                                        @follower.DisplayName
                                    </a>
                                </h3>

                                <p>@("@" + follower.UserName)</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section id="following"
                 class="profile-connections-section">
            <h2>Đang theo dõi (@Model.FollowingCount)</h2>

            @if (Model.Following.Count == 0)
            {
                <p>Chưa theo dõi ai.</p>
            }
            else
            {
                <div class="profile-user-list">
                    @foreach (var following in Model.Following)
                    {
                        <div class="user-card">
                            <div class="user-card-info">
                                <h3>
                                    <a asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-userId="@following.UserId">
                                        @following.DisplayName
                                    </a>
                                </h3>

                                <p>@("@" + following.UserName)</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @if (Model.IsOwner)
        {
            <section id="favorites">
                <h2>Công thức đã lưu (<span data-saved-count>@Model.Favorites.Count</span>)</h2>
                <p id="profileFavoriteEmptyState" style="@(Model.Favorites.Count == 0 ? null : "display:none")">Bạn chưa lưu công thức nào.</p>
                <div class="recipe-grid" id="profileFavoriteGrid" style="@(Model.Favorites.Count == 0 ? "display:none" : null)"
                     data-state-url="@Url.Action("State", "RecipeFavorites")" data-saved-user-id="@Model.UserId"
                     data-login-url="@Url.Action("Login", "Account", new { returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString })">
                    @foreach (var recipe in Model.Favorites)
                    {
                        <partial name="_RecipeCard" model="recipe" view-data='new ViewDataDictionary(ViewData) { ["SavedCollection"] = true }' />
                    }
                </div>
            </section>
        }

        @if (Model.IsOwner)
        {
            <dialog class="highlight-dialog" id="highlightDialog" aria-labelledby="highlightDialogTitle">
                <form asp-action="Highlights" method="post" id="highlightForm">
                    @Html.AntiForgeryToken()
                    <div class="highlight-dialog-header">
                        <h2 id="highlightDialogTitle">Quản lý công thức nổi bật</h2>
                        <p>Ghim tối đa 3 món do bạn đăng. Thứ tự trong danh sách là thứ tự hiển thị.</p>
                    </div>
                    <p class="highlight-count" id="highlightCount" aria-live="polite">@Model.FeaturedRecipes.Count/3</p>
                    <p class="highlight-form-error" id="highlightFormError" role="alert" hidden></p>
                    @if (Model.Recipes.Count == 0)
                    {
                        <p>Bạn chưa có công thức để ghim.</p>
                    }
                    else
                    {
                        <ul class="highlight-picker" id="highlightPicker">
                            @foreach (var recipe in pickerRecipes)
                            {
                                var pinned = Model.FeaturedRecipes.Any(item => item.Id == recipe.Id);
                                <li data-recipe-id="@recipe.Id">
                                    <label>
                                        <input type="checkbox" data-highlight-choice @(pinned ? "checked" : null) />
                                        <span>
                                            <strong>@recipe.Name</strong>
                                            <small>@recipe.Category</small>
                                        </span>
                                    </label>
                                    <span class="highlight-order">
                                        <button type="button" data-move="up">Lên</button>
                                        <button type="button" data-move="down">Xuống</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    <div id="highlightInputs">
                        @foreach (var recipe in Model.FeaturedRecipes)
                        {
                            <input type="hidden" name="recipeIds" value="@recipe.Id" />
                        }
                    </div>
                    <div class="highlight-dialog-actions">
                        <button type="button" class="btn btn-secondary" data-highlight-cancel>Hủy</button>
                        <button type="submit" class="btn">Lưu</button>
                    </div>
                </form>
            </dialog>
        }

    </div>
</section>

@section Scripts {
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-interactions.js" asp-append-version="true"></script>
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
    <script src="~/js/creator-profile.js" asp-append-version="true"></script>
}
