@model CookShare.ViewModels.ForgotPasswordInput

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-page container">
    <div class="auth-shell">
        <partial name="_AuthAside" />
        <div class="auth-form-area">
            <a class="back-link" asp-action="Login">← Về đăng nhập</a>
            <span class="eyebrow">KHÔI PHỤC TRUY CẬP</span>
            <h1>Quên mật khẩu</h1>
            <p class="auth-subtitle">
                Nhập email của tài khoản. Nếu email đã được đăng ký,
                CookShare sẽ gửi hướng dẫn đặt lại mật khẩu.
            </p>
            <form asp-action="ForgotPassword" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-field-group">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="form-input" asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button class="btn btn-full" type="submit">Gửi hướng dẫn</button>
            </form>
        </div>
    </div>
</section>
