@model CookShare.ViewModels.ResetPasswordInput

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-page container">
    <div class="auth-shell">
        <partial name="_AuthAside" />
        <div class="auth-form-area">
            <a class="back-link" asp-action="Login">← Về đăng nhập</a>
            <span class="eyebrow">MẬT KHẨU MỚI</span>
            <h1>Đặt lại mật khẩu</h1>
            <p class="auth-subtitle">Liên kết đặt lại mật khẩu có hiệu lực trong 1 giờ.</p>
            <form asp-action="ResetPassword" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Code" />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-field-group">
                    <label class="form-label" asp-for="Password">Mật khẩu mới</label>
                    <input class="form-input" asp-for="Password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-field-group">
                    <label class="form-label" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input class="form-input" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button class="btn btn-full" type="submit">Lưu mật khẩu</button>
            </form>
        </div>
    </div>
</section>
