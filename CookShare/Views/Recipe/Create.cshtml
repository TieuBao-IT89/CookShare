@model CookShare.ViewModels.RecipeFormViewModel

@{
    ViewData["Title"] = "Chia sẻ công thức";
    ViewData["IsEditing"] = false;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/recipe.css"
          asp-append-version="true" />
}

<partial name="_RecipeForm" model="Model" />

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
}
