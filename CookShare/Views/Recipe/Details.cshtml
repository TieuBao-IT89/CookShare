@model CookShare.Models.Recipe
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var ingredients = Model.Ingredients.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var instructions = Model.Instructions.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var authorName = Model.User?.DisplayName ?? Model.User?.UserName ?? "CookShare";
    var authorInitial = string.IsNullOrWhiteSpace(authorName) ? "C" : authorName.Trim()[..1].ToUpperInvariant();
    var liked = Model.Likes.Any(like => like.UserId == currentUserId);
    var cover = string.IsNullOrEmpty(Model.Image) ? "/img/recipe-placeholder.svg" : Model.Image;
}

@section Styles {
    <link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-comments.css" asp-append-version="true" />
}

<div class="recipe-page-wrapper">
    <div class="container recipe-details-wrapper">
        <nav class="recipe-breadcrumb" aria-label="Đường dẫn">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <a asp-controller="Recipe" asp-action="Index">Khám phá</a>
            <span>/</span>
            <span aria-current="page">@Model.Name</span>
        </nav>

        @if (TempData["Success"] != null)
        {
            <p class="notice" role="status">@TempData["Success"]</p>
        }

        <article class="details-hero-card" data-recipe-id="@Model.Id">
            <div class="details-cover-image">
                <img src="@cover"
                     alt="@Model.Name"
                     width="1100"
                     height="700"
                     fetchpriority="high" />
            </div>
            <div class="details-hero-copy">
                <div class="details-top-bar">
                    <span class="details-category-tag">@Model.Category</span>
                </div>
                <h1 class="details-title">@Model.Name</h1>
                @if (!string.IsNullOrEmpty(Model.UserId))
                {
                    <a class="details-author"
                       asp-controller="Profile"
                       asp-action="Index"
                       asp-route-userId="@Model.UserId">
                        @if (!string.IsNullOrWhiteSpace(Model.User?.AvatarUrl))
                        {
                            <img src="@Model.User.AvatarUrl" alt="" width="40" height="40" />
                        }
                        else
                        {
                            <span class="details-author-mark" aria-hidden="true">@authorInitial</span>
                        }
                        <span>Công thức từ <b>@authorName</b></span>
                    </a>
                }
                else
                {
                    <p class="details-meta-item">Công thức từ <b>@authorName</b></p>
                }
                <div class="details-meta-row">
                    <span class="details-meta-item">@ingredients.Length nguyên liệu</span>
                    <span class="details-meta-item">@instructions.Length bước</span>
                    <span class="details-meta-item">@Model.Likes.Count lượt thích</span>
                </div>
                <p class="details-desc-box">@Model.Description</p>
                <div class="details-actions">
                    <form asp-action="Like" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary like-button@(liked ? " is-liked" : "")">
                            <svg class="icon" aria-hidden="true"><use href="#i-heart" /></svg>
                            <span>@(liked ? "Bỏ thích" : "Thích") (@Model.Likes.Count)</span>
                        </button>
                    </form>
                </div>
                <nav class="details-jump" aria-label="Trong trang">
                    <a href="#ingredients">Nguyên liệu</a>
                    <a href="#instructions">Cách làm</a>
                    <a href="#comments">Bình luận</a>
                </nav>
            </div>
        </article>

        <div class="details-content-grid">
            <section class="ingredients-card" id="ingredients" aria-labelledby="ingredientHeading">
                <h2 class="section-card-title" id="ingredientHeading">
                    <svg class="icon" aria-hidden="true"><use href="#i-leaf" /></svg>
                    Nguyên liệu
                </h2>
                @if (ingredients.Length > 0)
                {
                    <p class="ingredient-progress"><span id="ingredientCheckedCount">0/@ingredients.Length</span> đã chuẩn bị</p>
                }
                <ul class="ingredient-list">
                    @foreach (var ingredient in ingredients)
                    {
                        <li class="ingredient-item">
                            <label><input type="checkbox" /><span>@ingredient</span></label>
                        </li>
                    }
                </ul>
            </section>

            <section class="instructions-card" id="instructions" aria-labelledby="instructionHeading">
                <h2 class="section-card-title" id="instructionHeading">
                    <svg class="icon" aria-hidden="true"><use href="#i-spark" /></svg>
                    Cùng vào bếp
                </h2>
                <div class="instruction-steps">
                    @for (var index = 0; index < instructions.Length; index++)
                    {
                        <div class="instruction-step-item">
                            <span class="step-number">@(index + 1)</span>
                            <p class="step-text">@instructions[index]</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        @if (TempData["Error"] != null)
        {
            <p class="notice" role="alert">@TempData["Error"]</p>
        }

        <section class="comment-section" id="comments" aria-labelledby="commentsHeading">
            <header class="comment-section-header">
                <h2 class="comment-section-title" id="commentsHeading">
                    Bình luận
                    <span class="comment-count-badge">@Model.Comments.Count</span>
                </h2>
            </header>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="comment-form-area" asp-action="AddComment" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="comment-form-content">
                        <label class="form-label" for="commentContent">Chia sẻ cảm nhận của bạn</label>
                        <div class="comment-textarea-wrapper">
                            <textarea id="commentContent"
                                      name="content"
                                      class="comment-textarea"
                                      maxlength="1000"
                                      required
                                      placeholder="Món này hợp với ai, hoặc bạn đã chỉnh gì khi nấu?"></textarea>
                        </div>
                        <div class="comment-form-actions">
                            <button type="submit" class="btn-submit-comment">Gửi bình luận</button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <p class="comment-login-note"><a asp-controller="Account" asp-action="Login">Đăng nhập</a> để bình luận.</p>
            }

            @if (Model.Comments.Count == 0)
            {
                <div class="comment-empty-state">
                    <p class="comment-empty-state-text">Chưa có bình luận nào. Hãy là người đầu tiên kể lại cảm nhận sau khi nấu.</p>
                </div>
            }
            else
            {
                <ul class="comment-list">
                    @foreach (var comment in Model.Comments.OrderByDescending(item => item.CreatedAt))
                    {
                        var commentAuthor = comment.User?.DisplayName ?? comment.User?.UserName ?? "CookShare User";
                        var commentInitial = string.IsNullOrWhiteSpace(commentAuthor) ? "C" : commentAuthor.Trim()[..1].ToUpperInvariant();
                        <li class="comment-item" id="comment-@comment.Id">
                            <div class="comment-avatar comment-avatar--small" aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(comment.User?.AvatarUrl))
                                {
                                    <img src="@comment.User.AvatarUrl" alt="" width="36" height="36" />
                                }
                                else
                                {
                                    @commentInitial
                                }
                            </div>
                            <div class="comment-body">
                                <div class="comment-header-row">
                                    <span class="comment-author-name">@commentAuthor</span>
                                    <time class="comment-timestamp" datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                                </div>
                                <p>@comment.Content</p>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <div class="details-footer-nav">
            <a class="btn btn-secondary" asp-controller="Recipe" asp-action="Index">← Khám phá thêm</a>
            @if (!string.IsNullOrEmpty(currentUserId) && Model.UserId == currentUserId)
            {
                <div>
                    <a class="btn btn-secondary" asp-controller="Recipe" asp-action="Edit" asp-route-id="@Model.Id">
                        <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg>
                        Chỉnh sửa
                    </a>
                    <form asp-controller="Recipe"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          data-confirm-delete="Bạn có chắc muốn xóa công thức này không?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                            Xóa công thức
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
}
