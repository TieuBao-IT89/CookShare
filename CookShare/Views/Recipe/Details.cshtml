@{ ViewData["Title"] = "Chi tiết công thức"; }
@section Styles {
    <link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-comments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-ratings.css" asp-append-version="true" />
}
<div class="recipe-page-wrapper"><div class="container recipe-details-wrapper">
    <nav class="recipe-breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><a href="/Recipe">Khám phá</a><span>/</span><span id="detailsBreadcrumbCurrent" aria-current="page">Chi tiết món ăn</span></nav>
    <input type="hidden" id="detailsRecipeId" value="@ViewBag.RecipeId" />
    <div id="recipeDetailsContainer"><partial name="_RecipeLoading" /></div>
</div></div>
@section Scripts {
    <script src="~/js/recipe.js" asp-append-version="true"></script>
    <script src="~/js/recipe-comments.js" asp-append-version="true"></script>
    <script src="~/js/recipe-likes.js" asp-append-version="true"></script>
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-ratings.js" asp-append-version="true"></script>
}
