@model CookShare.Models.Recipe
@using System.Security.Claims
@using CookShare.Helpers
@using CookShare.ViewModels

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var ingredients = Model.Ingredients.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var instructions = Model.Instructions.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var likeSummaries = ViewData["RecipeLikeSummaries"] as IReadOnlyDictionary<int, RecipeLikeViewModel>;
    var recipeLike = likeSummaries != null && likeSummaries.TryGetValue(Model.Id, out var summary) ? summary : null;
    var recipeComments = ViewData["RecipeComments"] as RecipeCommentsViewModel;
}

@section Styles {
    <link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-saved.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-comments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-interactions.css" asp-append-version="true" />
}

<div class="recipe-page-wrapper">
    <div class="container recipe-details-wrapper">
        <nav class="recipe-breadcrumb" aria-label="Đường dẫn">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <a asp-controller="Recipe" asp-action="Index">Khám phá</a>
            <span>/</span>
            <span aria-current="page">@Model.Name</span>
        </nav>

        @if (TempData["Success"] != null)
        {
            <p class="notice" role="status">@TempData["Success"]</p>
        }
        @if (TempData["Error"] != null)
        {
            <p class="notice error" role="alert">@TempData["Error"]</p>
        }

        <article class="details-hero-card" data-recipe-id="@Model.Id">
            <div class="details-top-bar">
                <span class="details-category-tag">@Model.Category</span>
                <div class="details-actions">
                    <partial name="_RecipeSaveButton" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SaveButtonClass"] = "btn btn-secondary btn-details-save" }' />
                    @if (recipeLike != null)
                    {
                        <partial name="_RecipeLikeButton" model="recipeLike" />
                    }
                </div>
            </div>
            <h1 class="details-title">@Model.Name</h1>
            <div class="details-meta-row">
                <span class="details-meta-item">
                    Công thức từ
                    @if (!string.IsNullOrEmpty(Model.UserId))
                    {
                        <a asp-controller="Profile" asp-action="Index" asp-route-userId="@Model.UserId"><b>@(Model.User?.DisplayName ?? Model.User?.UserName ?? "CookShare")</b></a>
                    }
                    else
                    {
                        <b>CookShare</b>
                    }
                </span>
                <span class="details-meta-item">@ingredients.Length nguyên liệu · @instructions.Length bước</span>
            </div>
            <p class="details-desc-box">@Model.Description</p>
            <div class="details-cover-image">
                <img src="@RecipeImageReference.GetSource(Model.Image)"
                     alt="@Model.Name"
                     width="1100"
                     height="700"
                     fetchpriority="high" />
            </div>
        </article>

        <div class="details-content-grid">
            <section class="ingredients-card" aria-labelledby="ingredientHeading">
                <h2 class="section-card-title" id="ingredientHeading">Nguyên liệu</h2>
                <ul class="ingredient-list">
                    @foreach (var ingredient in ingredients)
                    {
                        <li class="ingredient-item">
                            <label><input type="checkbox" /><span>@ingredient</span></label>
                        </li>
                    }
                </ul>
            </section>

            <section class="instructions-card" aria-labelledby="instructionHeading">
                <h2 class="section-card-title" id="instructionHeading">Cùng vào bếp</h2>
                <div class="instruction-steps">
                    @for (var index = 0; index < instructions.Length; index++)
                    {
                        <div class="instruction-step-item">
                            <span class="step-number">@(index + 1)</span>
                            <p class="step-text">@instructions[index]</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        @if (recipeComments != null)
        {
            <partial name="_RecipeComments" model="recipeComments" />
        }

        <div class="details-footer-nav">
            <a class="btn btn-secondary" asp-controller="Recipe" asp-action="Index">← Khám phá thêm</a>
            @if (!string.IsNullOrEmpty(currentUserId) && Model.UserId == currentUserId)
            {
                <div>
                    <a class="btn btn-secondary" asp-controller="Recipe" asp-action="Edit" asp-route-id="@Model.Id">
                        Chỉnh sửa
                    </a>
                    <form asp-controller="Recipe"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          data-confirm-delete="Bạn có chắc muốn xóa công thức này không?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Xóa công thức</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-interactions.js" asp-append-version="true"></script>
}
