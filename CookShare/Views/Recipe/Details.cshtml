
@model CookShare.Models.Recipe
@using System.Security.Claims
@using CookShare.Helpers
@using CookShare.ViewModels

@{
    ViewData["Title"] = Model.Name;

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var isOwner = !string.IsNullOrEmpty(userId)
        && Model.UserId == userId;

    var likeSummaries = ViewData["RecipeLikeSummaries"] as IReadOnlyDictionary<int, RecipeLikeViewModel>;
    var recipeLike = likeSummaries != null && likeSummaries.TryGetValue(Model.Id, out var summary) ? summary : null;
    var recipeComments = ViewData["RecipeComments"] as RecipeCommentsViewModel;
    var relatedRecipes = ViewData["RelatedRecipes"] as IReadOnlyList<Recipe> ?? Array.Empty<Recipe>();
    var ratingSummaries = ViewData["RecipeRatingSummaries"] as IReadOnlyDictionary<int, RecipeRatingViewModel>;
    var recipeRating = ratingSummaries != null && ratingSummaries.TryGetValue(Model.Id, out var rating) ? rating : null;

    var ingredients = Model.Ingredients.Split(
        '\n',
        StringSplitOptions.RemoveEmptyEntries
        | StringSplitOptions.TrimEntries);

    var instructions = Model.Instructions.Split(
        '\n',
        StringSplitOptions.RemoveEmptyEntries
        | StringSplitOptions.TrimEntries);

    var image = RecipeImageReference.GetSource(Model.Image);

    var author = Model.User?.DisplayName
        ?? Model.User?.UserName
        ?? "Thành viên CookShare";

    var authorAvatar = string.IsNullOrWhiteSpace(Model.User?.AvatarUrl)
        || !RecipeImageReference.IsValid(Model.User?.AvatarUrl)
        ? Url.Content("~/img/recipes/profile-avatar.webp")
        : RecipeImageReference.GetSource(Model.User!.AvatarUrl);

    var shareUrl = Url.Action("Details", "Recipe", new { id = Model.Id }, Context.Request.Scheme);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/recipe.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-saved.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-comments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-ratings.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/issue108.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/recipe-share.css"
          asp-append-version="true" />
}

<div class="recipe-page-wrapper cs108">
    <div class="container recipe-details-wrapper">

        <nav class="recipe-breadcrumb" aria-label="Đường dẫn">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <a asp-controller="Recipe" asp-action="Index">Khám phá</a>
            <span>/</span>
            <span aria-current="page">@Model.Name</span>
        </nav>

        @if (TempData["Success"] != null)
        {
            <p class="notice" role="status">@TempData["Success"]</p>
        }

        <article class="details-hero-card cs108-recipe-hero" data-recipe-id="@Model.Id">

            <div class="cs108-hero-content">
                <span class="details-category-tag">
                    <svg class="icon" aria-hidden="true">
                        <use href="#i-leaf" />
                    </svg>
                    @Model.Category
                </span>

                <h1 class="details-title">@Model.Name</h1>

                <p class="details-desc-box">@Model.Description</p>

                @if (Model.Source == "themealdb" && !string.IsNullOrEmpty(Model.ExternalId))
                {
                    <p class="cs108-muted-label">
                        Nguồn công thức:
                        <a href="https://www.themealdb.com/meal.php?c=@Uri.EscapeDataString(Model.ExternalId)" rel="external noopener noreferrer">TheMealDB</a>
                        @if (Uri.TryCreate(Model.SourceUrl, UriKind.Absolute, out _) && RecipeImageReference.IsValid(Model.SourceUrl))
                        {
                            <span> · <a href="@Model.SourceUrl" rel="external noopener noreferrer">Tham khảo gốc</a></span>
                        }
                    </p>
                }

                <div class="cs108-author-row">
                    <img src="@authorAvatar"
                         alt=""
                         class="cs108-author-avatar"
                         width="48"
                         height="48" />

                    <div>
                        <span class="cs108-muted-label">
                            Công thức được chia sẻ bởi
                        </span>

                        @if (!string.IsNullOrEmpty(Model.UserId))
                        {
                            <a asp-controller="Profile"
                               asp-action="Index"
                               asp-route-userId="@Model.UserId"
                               class="cs108-author-name">
                                @author
                            </a>
                        }
                        else
                        {
                            <strong class="cs108-author-name">
                                @author
                            </strong>
                        }
                    </div>
                </div>

                <div class="cs108-recipe-summary">
                    @if (recipeRating != null)
                    {
                        <partial name="_RecipeRatingSummary" model="recipeRating" />
                    }
                    <span>
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-grid" />
                        </svg>
                        @ingredients.Length nguyên liệu
                    </span>
                    <span>
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-check" />
                        </svg>
                        @instructions.Length bước chế biến
                    </span>
                </div>

                <div class="details-actions cs108-social-actions">
                    <partial name="_RecipeSaveButton" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SaveButtonClass"] = "btn btn-secondary btn-details-save" }' />
                    @if (recipeLike != null)
                    {
                        <partial name="_RecipeLikeButton" model="recipeLike" />
                    }
                    <a href="#comments" class="btn btn-secondary">
                        Bình luận (<span data-db-comment-count>@(recipeComments?.Comments.Count ?? Model.Comments.Count)</span>)
                    </a>
                </div>

                <div class="recipe-share-actions"
                     data-recipe-share
                     data-share-url="@shareUrl"
                     data-share-title="@Model.Name"
                     data-share-success="Đã sao chép liên kết công thức."
                     data-share-failure="Không sao chép được liên kết. Hãy chọn liên kết bên dưới.">
                    <button type="button" class="btn btn-secondary" data-recipe-share-native>
                        <i class="icon fa-solid fa-share-nodes" aria-hidden="true"></i>
                        Chia sẻ
                    </button>
                    <button type="button" class="btn btn-secondary" data-recipe-copy-link>
                        <i class="icon fa-solid fa-link" aria-hidden="true"></i>
                        Sao chép liên kết
                    </button>
                    <button type="button" class="btn btn-secondary" data-recipe-print>
                        <i class="icon fa-solid fa-print" aria-hidden="true"></i>
                        In công thức
                    </button>
                    <p id="recipeShareStatus" class="recipe-share-status" role="status" hidden></p>
                </div>
            </div>

            <div class="details-cover-image cs108-recipe-cover">
                <img src="@image"
                     alt="@Model.Name"
                     width="1100"
                     height="700"
                     fetchpriority="high" />
            </div>
        </article>

        <nav class="cs108-quick-nav"
             aria-label="Nội dung công thức">
            <a href="#ingredients">Nguyên liệu</a>
            <a href="#instructions">Cách chế biến</a>
            <a href="#comments">Bình luận</a>
        </nav>

        <div class="details-content-grid">

            <section class="ingredients-card"
                     id="ingredients"
                     aria-labelledby="ingredientHeading">

                <span class="eyebrow">CHUẨN BỊ NGUYÊN LIỆU</span>

                <h2 class="section-card-title"
                    id="ingredientHeading">
                    Nguyên liệu
                </h2>

                <p class="ingredient-progress"
                   id="cs108IngredientProgress"
                   aria-live="polite">
                    Đã chuẩn bị 0/@ingredients.Length nguyên liệu
                </p>

                <ul class="ingredient-list">
                    @foreach (var ingredient in ingredients)
                    {
                        <li class="ingredient-item">
                            <label>
                                <input type="checkbox"
                                       class="cs108-ingredient-check" />
                                <span>@ingredient</span>
                            </label>
                        </li>
                    }
                </ul>
            </section>

            <section class="instructions-card"
                     id="instructions"
                     aria-labelledby="instructionHeading">

                <span class="eyebrow">CÙNG VÀO BẾP</span>

                <h2 class="section-card-title"
                    id="instructionHeading">
                    Cách chế biến
                </h2>

                <div class="instruction-steps cs108-timeline">
                    @for (int i = 0; i < instructions.Length; i++)
                    {
                        <div class="instruction-step-item">
                            <span class="step-number">
                                @(i + 1)
                            </span>

                            <div class="cs108-step-content">
                                <h3>Bước @(i + 1)</h3>
                                <p class="step-text">
                                    @instructions[i]
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        @if (TempData["Error"] != null)
        {
            <p class="notice error" role="alert">@TempData["Error"]</p>
        }

        @if (recipeRating != null)
        {
            <partial name="_RecipeRating" model="recipeRating" />
        }

        @if (recipeComments != null)
        {
            <div class="cs108-comments" id="comments">
                <partial name="_RecipeComments" model="recipeComments" />
            </div>
        }

        <section class="section related-section" aria-labelledby="relatedHeading">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">CÙNG DANH MỤC</span>
                    <h2 id="relatedHeading">Công thức liên quan</h2>
                </div>
            </div>
            <div class="@(relatedRecipes.Count == 0 ? "" : "recipe-grid")" id="relatedRecipes">
                @foreach (var related in relatedRecipes)
                {
                    <partial name="_RecipeCard" model="related" />
                }
                @if (relatedRecipes.Count == 0)
                {
                    <p class="discovery-empty" id="relatedRecipesEmpty">Chưa có công thức liên quan trong danh mục này.</p>
                }
            </div>
        </section>

        <div class="details-footer-nav">
            <a asp-controller="Recipe"
               asp-action="Index"
               class="btn btn-secondary">
                ← Khám phá thêm
            </a>

            @if (isOwner)
            {
                <div>
                    <a asp-controller="Recipe"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary">
                        Chỉnh sửa
                    </a>

                    <form asp-controller="Recipe"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          data-confirm-delete="Bạn có chắc muốn xóa công thức này không?">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">
                            Xóa công thức
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recipe-actions.js"
            asp-append-version="true"></script>
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-interactions.js" asp-append-version="true"></script>
    <script src="~/js/recipe-ratings.js" asp-append-version="true"></script>
    <script src="~/js/issue108.js"
            asp-append-version="true"></script>
    <script src="~/js/recipe-share.js"
            asp-append-version="true"></script>
}

<dialog class="recipe-share-dialog" data-recipe-share-dialog aria-labelledby="recipeShareDialogTitle">
    <form method="dialog">
        <h2 id="recipeShareDialogTitle">Sao chép liên kết công thức</h2>
        <p>Liên kết này mở đúng công thức đang lưu trên CookShare.</p>
        <label for="recipeShareLink">Liên kết</label>
        <input id="recipeShareLink" type="url" readonly value="@shareUrl" />
        <button class="btn btn-secondary" value="cancel">Đóng</button>
    </form>
</dialog>
