@{ ViewData["Title"] = "Khám phá công thức"; }
@section Styles {
    <link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
}
<div class="recipe-page-wrapper">
    <section class="page-intro recipe-intro container">
        <div><span class="eyebrow"><svg class="icon"><use href="#i-chef" /></svg> CẢM HỨNG CHO MỖI BỮA ĂN</span><h1>Khám phá <em>món ngon.</em></h1><p>Tìm công thức bạn yêu, từ những nguyên liệu quen thuộc.</p></div>
        <a class="btn" href="/Recipe/Create"><svg class="icon"><use href="#i-plus" /></svg> Thêm công thức</a>
    </section>
    <section class="container recipe-toolbar-section" aria-label="Tìm kiếm và lọc công thức">
        <div class="recipe-toolbar-grid">
            <div class="recipe-search-wrap"><svg class="icon"><use href="#i-search" /></svg><label class="sr-only" for="searchRecipe">Tên món, mô tả hoặc nguyên liệu</label><input id="searchRecipe" type="search" placeholder="Tìm theo tên món hoặc nguyên liệu..." /></div>
            <div class="recipe-filter-wrap"><label class="sr-only" for="categoryFilter">Lọc theo danh mục</label><select id="categoryFilter"><partial name="_CategoryOptions" /></select></div>
        </div>
        <div class="recipe-category-pills" aria-label="Danh mục nhanh">
            <button type="button" class="category-pill active" data-category="" aria-pressed="true">Tất cả</button>
            <button type="button" class="category-pill" data-category="Món Việt" aria-pressed="false">🍜 Món Việt</button>
            <button type="button" class="category-pill" data-category="Món Á" aria-pressed="false">🍱 Món Á</button>
            <button type="button" class="category-pill" data-category="Món Âu" aria-pressed="false">🍝 Món Âu</button>
            <button type="button" class="category-pill" data-category="Món chay" aria-pressed="false">🥗 Món chay</button>
            <button type="button" class="category-pill" data-category="Món tráng miệng" aria-pressed="false">🍰 Tráng miệng</button>
            <button type="button" class="category-pill" data-category="Đồ uống" aria-pressed="false">🍹 Đồ uống</button>
        </div>
        <div class="recipe-results-bar"><p id="recipeResultsCount" role="status" aria-live="polite">Đang tải công thức...</p><button type="button" class="text-link" id="resetRecipeFilters">Đặt lại bộ lọc</button></div>
    </section>
    <section class="container recipe-grid-section" aria-label="Danh sách công thức">
        <div id="recipeList" class="recipe-grid"><partial name="_RecipeLoading" /></div>
        <div id="emptyRecipe" class="recipe-empty-container" style="display:none" role="status">
            <span class="state-icon"><svg class="icon"><use href="#i-search" /></svg></span>
            <h2 class="recipe-empty-title">Chưa có công thức nào</h2><p class="recipe-empty-desc">Hãy chia sẻ món ngon đầu tiên của bạn.</p>
            <a class="btn" href="/Recipe/Create"><svg class="icon"><use href="#i-plus" /></svg> Chia sẻ công thức</a>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/recipe.js" asp-append-version="true"></script>
    <script src="~/js/recipe-likes.js" asp-append-version="true"></script>
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
}
