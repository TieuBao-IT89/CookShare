@model IEnumerable<CookShare.Models.Recipe>
@using System.Security.Claims

@{
    ViewData["Title"] = "Khám phá công thức";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/recipe.css"
          asp-append-version="true" />
}

<div class="recipe-page-wrapper">
    <div class="container recipe-grid-section">
        <header class="page-intro">
            <h1>Khám phá <em>món ngon.</em></h1>
            <a asp-controller="Recipe" asp-action="Create" class="btn">
                + Chia sẻ công thức
            </a>
        </header>

        @if (TempData["Success"] != null)
        {
            <p class="notice" role="status">@TempData["Success"]</p>
        }

        @if (!Model.Any())
        {
            <div class="recipe-empty-container">
                <h2>Chưa có công thức nào</h2>
                <p>Hãy chia sẻ món ngon đầu tiên của bạn!</p>
            </div>
        }
        else
        {
            <div class="recipe-grid">
                @foreach (var recipe in Model)
                {
                    <article class="recipe-card">
                        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id">
                            <img src="@(string.IsNullOrEmpty(recipe.Image) ? "/img/recipe-placeholder.svg" : recipe.Image)"
                                 alt="@recipe.Name"
                                 loading="lazy" />
                            <h2>@recipe.Name</h2>
                        </a>

                        <p>@recipe.Description</p>
                        <p>Danh mục: @recipe.Category</p>
                        <p>Tác giả: @(recipe.User?.DisplayName ?? recipe.User?.UserName ?? "CookShare")</p>

                        @if (!string.IsNullOrEmpty(currentUserId) && recipe.UserId == currentUserId)
                        {
                            <div class="recipe-manage-actions">
                                <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@recipe.Id">
                                    Chỉnh sửa
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@recipe.Id"
                                      method="post"
                                      data-confirm-delete="Bạn có chắc muốn xóa công thức này không?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                </form>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
}
