@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-page container"><div class="auth-shell">
    <partial name="_AuthAside" />
    <div class="auth-form-area"><a class="back-link" href="/">← Về trang chủ</a><span class="eyebrow">THÊM MỘT NGƯỜI BẠN YÊU BẾP</span><h1>Bắt đầu <em>câu chuyện.</em></h1><p class="auth-subtitle">Tạo tài khoản và tìm cảm hứng nấu ăn mỗi ngày.</p>
        <form class="auth-form" data-auth-form="register">
            <div class="form-row"><div class="form-field-group"><label class="form-label" for="registerLastName">Họ</label><input class="form-input" id="registerLastName" type="text" autocomplete="family-name" placeholder="Nguyễn" required /></div><div class="form-field-group"><label class="form-label" for="registerFirstName">Tên</label><input class="form-input" id="registerFirstName" type="text" autocomplete="given-name" placeholder="Hải" required /></div></div>
            <div class="form-field-group"><label class="form-label" for="registerUsername">Tên người dùng</label><input class="form-input" id="registerUsername" type="text" autocomplete="username" placeholder="Tên của bạn trong cộng đồng" required /></div>
            <div class="form-field-group"><label class="form-label" for="registerEmail">Email</label><input class="form-input" id="registerEmail" type="email" autocomplete="email" placeholder="ban@example.com" required /></div>
            <div class="form-row"><div class="form-field-group"><label class="form-label" for="registerPassword">Mật khẩu</label><div class="password-field"><input class="form-input" id="registerPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Ít nhất 8 ký tự" required aria-describedby="passwordHint" /><button type="button" class="password-toggle" data-password-target="registerPassword" aria-label="Hiện mật khẩu" aria-pressed="false"><svg class="icon"><use href="#i-eye" /></svg></button></div></div><div class="form-field-group"><label class="form-label" for="confirmPassword">Nhập lại mật khẩu</label><input class="form-input" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Xác nhận mật khẩu" required /></div></div>
            <p class="field-hint" id="passwordHint">Sử dụng ít nhất 8 ký tự cho mật khẩu của bạn.</p>
            <p class="notice auth-status" role="status" hidden></p>
            <button class="btn btn-full" type="submit">Tạo tài khoản <svg class="icon"><use href="#i-arrow" /></svg></button>
        </form>
        <p class="auth-switch">Đã là thành viên? <a href="/Home/Login">Đăng nhập ngay</a></p>
    </div>
</div></section>
