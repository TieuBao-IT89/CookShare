@{
    ViewData["Title"] = "Đăng ký";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f8fbf8;
        color: #333;
    }

    /* ================= HEADER ================= */

    .site-header {
        background: #ffffff;
        border-bottom: 1px solid #e1ebe2;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .container {
        width: 90%;
        max-width: 1200px;
        margin: auto;
    }

    .nav {
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .logo {
        text-decoration: none;
        color: #26332a;
        font-size: 26px;
        font-weight: 700;
        white-space: nowrap;
    }

        .logo span span {
            color: #4caf50;
        }

    .nav-links {
        display: flex;
        gap: 28px;
        align-items: center;
    }

        .nav-links a {
            text-decoration: none;
            color: #526057;
            font-size: 15px;
            transition: 0.3s;
        }

            .nav-links a:hover {
                color: #4caf50;
            }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search {
        border: 1px solid #dce7de;
        border-radius: 25px;
        padding: 8px 14px;
        background: #ffffff;
    }

        .search input {
            border: none;
            outline: none;
            width: 170px;
            font-size: 13px;
            color: #444;
        }

    .login {
        text-decoration: none;
        color: #4caf50;
        font-weight: 600;
    }

    .btn {
        display: inline-block;
        padding: 12px 22px;
        border-radius: 25px;
        background: #4caf50;
        color: white;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn:hover {
            background: #388e3c;
            transform: translateY(-2px);
        }

    .btn-small {
        padding: 9px 18px;
    }

    /* ================= REGISTER PAGE ================= */

    .register-page {
        min-height: calc(100vh - 78px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 20px;
        background: radial-gradient( circle at 10% 20%, rgba(76, 175, 80, 0.10), transparent 25% ), radial-gradient( circle at 90% 80%, rgba(76, 175, 80, 0.07), transparent 25% ), #f8fbf8;
    }

    .register-wrapper {
        width: 100%;
        max-width: 1050px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #ffffff;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(45, 75, 50, 0.12);
    }

    /* ================= BÊN TRÁI ================= */

    .register-intro {
        position: relative;
        min-height: 610px;
        padding: 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: #ffffff;
        overflow: hidden;
    }

    .register-food {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        transition: transform 0.5s ease;
    }

    .register-intro:hover .register-food {
        transform: scale(1.04);
    }

    .register-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient( 135deg, rgba(38, 90, 45, 0.76), rgba(67, 160, 71, 0.62) );
        z-index: 1;
    }

    .register-intro-content {
        position: relative;
        z-index: 2;
    }

    .register-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(5px);
        font-size: 32px;
        margin-bottom: 25px;
    }

    .register-intro h1 {
        font-size: 38px;
        margin: 0 0 18px;
        line-height: 1.2;
        color: #ffffff;
    }

        .register-intro h1 span {
            font-style: italic;
        }

    .register-intro p {
        line-height: 1.8;
        font-size: 16px;
        opacity: 0.95;
        max-width: 400px;
        color: #ffffff;
    }

    /* ================= BENEFITS ================= */

    .benefits {
        margin-top: 25px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .benefit {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        color: #ffffff;
    }

    .benefit-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        font-size: 13px;
    }

    /* ================= BÊN PHẢI ================= */

    .register-form-area {
        padding: 45px 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
    }

    .form-heading {
        text-align: center;
        margin-bottom: 25px;
    }

        .form-heading .eyebrow {
            color: #4caf50;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .form-heading h2 {
            font-size: 30px;
            margin: 9px 0;
            color: #26332a;
        }

        .form-heading p {
            color: #78837b;
            margin: 0;
            font-size: 14px;
        }

    /* ================= FORM ================= */

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 7px;
            color: #354139;
        }

    .form-input {
        width: 100%;
        height: 46px;
        border: 1px solid #dce7de;
        border-radius: 11px;
        padding: 0 14px;
        outline: none;
        font-size: 14px;
        color: #333;
        background: #fcfefd;
        transition: 0.3s;
    }

        .form-input::placeholder {
            color: #a2aaa4;
        }

        .form-input:focus {
            border-color: #4caf50;
            box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.13);
            background: #ffffff;
        }

    /* ================= PASSWORD HINT ================= */

    .password-hint {
        font-size: 11px;
        color: #8a948d;
        margin-top: 6px;
    }

    /* ================= TERMS ================= */

    .terms {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 3px 0 20px;
        font-size: 12px;
        color: #68736b;
        line-height: 1.5;
    }

        .terms input {
            margin-top: 3px;
            accent-color: #4caf50;
        }

        .terms a {
            color: #4caf50;
            text-decoration: none;
            font-weight: 600;
        }

            .terms a:hover {
                color: #388e3c;
                text-decoration: underline;
            }

    /* ================= REGISTER BUTTON ================= */

    .register-button {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 13px;
        background: #4caf50;
        color: white;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

        .register-button:hover {
            background: #388e3c;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(76, 175, 80, 0.25);
        }

    /* ================= LOGIN LINK ================= */

    .login-text {
        text-align: center;
        margin-top: 20px;
        color: #78837b;
        font-size: 13px;
    }

        .login-text a {
            color: #4caf50;
            text-decoration: none;
            font-weight: bold;
        }

            .login-text a:hover {
                color: #388e3c;
                text-decoration: underline;
            }

    /* ================= BACK HOME ================= */

    .back-home {
        text-align: center;
        margin-top: 18px;
    }

        .back-home a {
            text-decoration: none;
            color: #68736b;
            font-size: 13px;
            transition: 0.3s;
        }

            .back-home a:hover {
                color: #4caf50;
            }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 900px) {

        .nav-links,
        .search {
            display: none;
        }

        .register-wrapper {
            grid-template-columns: 1fr;
            max-width: 550px;
        }

        .register-intro {
            display: none;
        }

        .register-form-area {
            padding: 45px 35px;
        }
    }

    @@media (max-width: 500px) {

        .nav {
            height: 65px;
        }

        .register-page {
            padding: 25px 12px;
        }

        .register-form-area {
            padding: 35px 22px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .logo {
            font-size: 22px;
        }
    }
</style>


<!-- ================= HEADER ================= -->

<header class="site-header">

    <div class="container nav">

        <!-- LOGO -->

        <a class="logo"
           href="@Url.Action("Index", "Home")">

            ♨ <span>Cook<span>Share</span></span>

        </a>


        <!-- MENU -->

        <nav class="nav-links">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <a href="@Url.Action("Index", "Home")#featured">
                Công thức
            </a>

            <a href="@Url.Action("Index", "Home")#categories">
                Danh mục
            </a>

            <a href="@Url.Action("Index", "Home")#share">
                Chia sẻ công thức
            </a>

        </nav>


        <!-- ACTION -->

        <div class="nav-actions">

            <label class="search">

                <input type="search"
                       placeholder="Tìm kiếm công thức..." />

                ⌕

            </label>

            <a class="login"
               href="@Url.Action("Login", "Home")">

                Đăng nhập

            </a>

            <a class="btn btn-small"
               href="@Url.Action("Register", "Home")">

                Đăng ký

            </a>

        </div>

    </div>

</header>


<!-- ================= REGISTER ================= -->

<main class="register-page">

    <div class="register-wrapper">


        <!-- ================= LEFT ================= -->

        <div class="register-intro">

            <img class="register-food"
                 src="/img/bg_login.png"
                 alt="Món ăn CookShare" />

            <div class="register-overlay"></div>


            <div class="register-intro-content">

                <h1>

                    Tham gia cộng đồng
                    <span>CookShare</span>

                </h1>


                <p>

                    Tạo tài khoản để khám phá hàng nghìn
                    công thức nấu ăn, chia sẻ những món ngon
                    và kết nối với cộng đồng yêu bếp.

                </p>


                <div class="benefits">


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <span>
                            Lưu những công thức yêu thích
                        </span>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <span>
                            Đăng và chia sẻ công thức riêng
                        </span>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <span>
                            Theo dõi những người yêu nấu ăn
                        </span>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            ✓
                        </div>

                        <span>
                            Xây dựng bộ sưu tập món ăn cá nhân
                        </span>

                    </div>


                </div>

            </div>

        </div>


        <!-- ================= RIGHT ================= -->

        <div class="register-form-area">


            <div class="form-heading">

                <span class="eyebrow">
                    JOIN COOKSHARE
                </span>

                <h2>
                    Tạo tài khoản
                </h2>

                <p>
                    Bắt đầu hành trình khám phá ẩm thực
                </p>

            </div>


            <form>


                <!-- HỌ + TÊN -->

                <div class="form-row">

                    <div class="form-group">

                        <label>
                            Họ
                        </label>

                        <input type="text"
                               class="form-input"
                               placeholder="Nhập họ" />

                    </div>


                    <div class="form-group">

                        <label>
                            Tên
                        </label>

                        <input type="text"
                               class="form-input"
                               placeholder="Nhập tên" />

                    </div>

                </div>


                <!-- USERNAME -->

                <div class="form-group">

                    <label>
                        Tên người dùng
                    </label>

                    <input type="text"
                           class="form-input"
                           placeholder="Ví dụ: nguyenan123" />

                </div>


                <!-- EMAIL -->

                <div class="form-group">

                    <label>
                        Email
                    </label>

                    <input type="email"
                           class="form-input"
                           placeholder="example@gmail.com" />

                </div>


                <!-- PASSWORD -->

                <div class="form-row">

                    <div class="form-group">

                        <label>
                            Mật khẩu
                        </label>

                        <input type="password"
                               class="form-input"
                               placeholder="Nhập mật khẩu" />

                    </div>


                    <div class="form-group">

                        <label>
                            Xác nhận
                        </label>

                        <input type="password"
                               class="form-input"
                               placeholder="Nhập lại mật khẩu" />

                    </div>

                </div>


                <div class="password-hint">

                    Mật khẩu nên có ít nhất 8 ký tự.

                </div>


                <!-- TERMS -->

                <label class="terms">

                    <input type="checkbox" />

                    <span>

                        Tôi đồng ý với
                        <a href="#">
                            Điều khoản sử dụng
                        </a>

                        và
                        <a href="#">
                            Chính sách bảo mật
                        </a>
                        của CookShare.

                    </span>

                </label>


                <!-- BUTTON -->

                <button type="submit"
                        class="register-button">

                    Tạo tài khoản 

                </button>


            </form>


            <!-- LOGIN -->

            <div class="login-text">

                Bạn đã có tài khoản?

                <a href="@Url.Action("Login", "Home")">

                    Đăng nhập ngay

                </a>

            </div>


            <!-- BACK HOME -->

            <div class="back-home">

                <a href="@Url.Action("Index", "Home")">

                     Quay lại trang chủ

                </a>

            </div>


        </div>

    </div>

</main>