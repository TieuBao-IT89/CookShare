@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-page container"><div class="auth-shell">
    <partial name="_AuthAside" />
    <div class="auth-form-area"><a class="back-link" href="/">← Về trang chủ</a><span class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</span><h1>Lại cùng <em>vào bếp.</em></h1><p class="auth-subtitle">Một chút cảm hứng mới đang chờ bạn.</p>
        <form class="auth-form" data-auth-form="login">
            <div class="form-field-group"><label class="form-label" for="loginEmail">Tên người dùng hoặc email</label><input class="form-input" id="loginEmail" type="text" autocomplete="username" placeholder="Email hoặc tên người dùng của bạn" required /></div>
            <div class="form-field-group"><label class="form-label" for="loginPassword">Mật khẩu</label><div class="password-field"><input class="form-input" id="loginPassword" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required /><button type="button" class="password-toggle" data-password-target="loginPassword" aria-label="Hiện mật khẩu" aria-pressed="false"><svg class="icon"><use href="#i-eye" /></svg></button></div></div>
            <div class="form-options"><label class="checkbox-label"><input type="checkbox" /> Ghi nhớ đăng nhập</label><button type="button" class="text-link" data-feature-notice="Tính năng khôi phục mật khẩu đang được hoàn thiện.">Quên mật khẩu?</button></div>
            <p class="notice auth-status" role="status" hidden></p>
            <button class="btn btn-full" type="submit">Đăng nhập <svg class="icon"><use href="#i-arrow" /></svg></button>
        </form>
        <p class="auth-switch">Chưa có tài khoản? <a href="/Home/Register">Tham gia CookShare</a></p>
        <div class="auth-footnote"><svg class="icon"><use href="#i-leaf" /></svg> Thêm yêu bếp, thêm yêu những bữa cơm nhà.</div>
    </div>
</div></section>
