@model CookShare.ViewModels.HomeIndexViewModel
@using CookShare.Helpers
@{ ViewData["Title"] = "Cảm hứng cho căn bếp của bạn"; }
@section Styles {
    <link rel="stylesheet" href="~/css/recipe-saved.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-follow.css" asp-append-version="true" />
}
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> TỪ CĂN BẾP, ĐẾN TRÁI TIM</span>
            <h1>Món ngon mỗi ngày.<br /><em>Cảm hứng</em> bất tận.</h1>
            <p>Khám phá công thức mới, lưu lại món bạn yêu và chia sẻ một chút hạnh phúc từ căn bếp của mình.</p>
            <form class="hero-search" asp-controller="Recipe" asp-action="Index" method="get" role="search">
                <svg class="icon"><use href="#i-search" /></svg>
                <label class="sr-only" for="homeSearch">Tìm món ăn hoặc nguyên liệu</label>
                <input id="homeSearch" type="search" name="q" placeholder="Hôm nay bạn muốn nấu gì?" />
                <button class="btn" type="submit" aria-label="Tìm công thức">Tìm công thức <svg class="icon"><use href="#i-arrow" /></svg></button>
            </form>
            <div class="search-suggestions"><span>Thử tìm:</span><a href="/Recipe?q=phở">Phở bò</a><a href="/Recipe?category=Món%20chay">Món chay</a><a href="/Recipe?q=bánh">Bánh ngọt</a></div>
            <div class="hero-community"><div class="avatar-stack"><span>HA</span><span>MA</span><span>LN</span></div><div><strong>Một cộng đồng, ngàn cảm hứng</strong><span>Cùng những người yêu bếp như bạn</span></div><svg class="icon"><use href="#i-heart" /></svg></div>
        </div>
        <div class="hero-visual">
            <div class="hero-photo-frame"><img src="~/img/recipes/salad.webp" alt="Đĩa salad rau củ tươi, đầy màu sắc trên bàn ăn" width="720" height="800" fetchpriority="high" /></div>
            <span class="hero-photo-label"><svg class="icon"><use href="#i-leaf" /></svg> Tươi ngon từ những điều giản dị</span>
            @if ((Model.FeaturedRecipes.FirstOrDefault() ?? Model.LatestRecipes.FirstOrDefault()) is { } suggestion)
            {
                <a class="hero-recipe-note" asp-controller="Recipe" asp-action="Details" asp-route-id="@suggestion.Id"><span class="note-icon"><svg class="icon"><use href="#i-chef" /></svg></span><span><small>GỢI Ý CHO HÔM NAY</small><strong>@suggestion.Name</strong><span>@suggestion.Category</span></span><svg class="icon"><use href="#i-arrow" /></svg></a>
            }
            else
            {
                <a class="hero-recipe-note" asp-controller="Recipe" asp-action="Create"><span class="note-icon"><svg class="icon"><use href="#i-chef" /></svg></span><span><small>CẢM HỨNG TỪ BẠN</small><strong>Chia sẻ món ngon đầu tiên</strong><span>Một câu chuyện mới từ căn bếp của bạn</span></span><svg class="icon"><use href="#i-arrow" /></svg></a>
            }
            <span class="hero-handwritten">made with love ♡</span>
        </div>
    </div>
</section>
<section class="category-section" id="categories" aria-labelledby="categoryHeading">
    <div class="container">
        <div class="section-heading compact"><div><span class="eyebrow">TÌM ĐÚNG HƯƠNG VỊ CỦA BẠN</span><h2 id="categoryHeading">Hôm nay, vào bếp với món gì?</h2></div><a class="text-link" href="/Recipe">Tất cả danh mục <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="category-grid">
            <a class="category-tile" href="/Recipe?category=Món%20Việt"><span class="category-art peach">🍜</span><strong>Món Việt</strong><small>Đậm đà vị nhà</small></a>
            <a class="category-tile" href="/Recipe?category=Món%20Á"><span class="category-art sand">🍱</span><strong>Món Á</strong><small>Khám phá hương vị</small></a>
            <a class="category-tile" href="/Recipe?category=Món%20Âu"><span class="category-art rose">🍝</span><strong>Món Âu</strong><small>Một chút mới mẻ</small></a>
            <a class="category-tile" href="/Recipe?category=Món%20chay"><span class="category-art sage">🥗</span><strong>Món chay</strong><small>Nhẹ nhàng, xanh mát</small></a>
            <a class="category-tile" href="/Recipe?category=Món%20tráng%20miệng"><span class="category-art lilac">🍰</span><strong>Tráng miệng</strong><small>Ngọt ngào một chút</small></a>
            <a class="category-tile" href="/Recipe?category=Đồ%20uống"><span class="category-art lemon">🍹</span><strong>Đồ uống</strong><small>Tươi mát mỗi ngày</small></a>
        </div>
    </div>
</section>
<section class="section featured-section" aria-labelledby="featuredHeading">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow"><svg class="icon"><use href="#i-spark" /></svg> CẢM HỨNG TỪ CỘNG ĐỒNG</span><h2 id="featuredHeading">Món ngon đáng thử</h2><p>Những công thức để bạn thêm yêu mỗi lần vào bếp.</p></div><a class="text-link" href="/Recipe">Khám phá thêm <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="@(Model.FeaturedRecipes.Count == 0 ? "" : "recipe-grid")" id="homeFeaturedGrid">
            @foreach (var recipe in Model.FeaturedRecipes)
            {
                <partial name="_RecipeCard" model="recipe" />
            }
            @if (Model.FeaturedRecipes.Count == 0)
            {
                @if (Model.LatestRecipes.Count == 0)
                {
                    <partial name="_RecipeEmpty" />
                }
                else
                {
                    <p class="discovery-empty" id="homeFeaturedEmpty">Chưa có món nổi bật. Hãy thích hoặc đánh giá một công thức.</p>
                }
            }
        </div>
    </div>
</section>
<section class="section" aria-labelledby="popularHeading">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">ĐƯỢC YÊU THÍCH NHIỀU NHẤT</span><h2 id="popularHeading">Món đang được yêu thích</h2><p>Những món đang nhận nhiều lượt thích nhất.</p></div><a class="text-link" href="/Recipe">Khám phá thêm <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="@(Model.PopularRecipes.Count == 0 ? "" : "recipe-grid")" id="homePopularGrid">
            @foreach (var recipe in Model.PopularRecipes)
            {
                <partial name="_RecipeCard" model="recipe" />
            }
            @if (Model.PopularRecipes.Count == 0)
            {
                <p class="discovery-empty" id="homePopularEmpty">Chưa có công thức nào được yêu thích.</p>
            }
        </div>
    </div>
</section>
<section class="section" aria-labelledby="topRatedHeading">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">ĐIỂM TỪ CỘNG ĐỒNG</span><h2 id="topRatedHeading">Món được đánh giá cao</h2><p>Những món được chấm điểm cao nhất.</p></div><a class="text-link" href="/Recipe">Khám phá thêm <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="@(Model.TopRatedRecipes.Count == 0 ? "" : "recipe-grid")" id="homeTopRatedGrid">
            @foreach (var recipe in Model.TopRatedRecipes)
            {
                <partial name="_RecipeCard" model="recipe" />
            }
            @if (Model.TopRatedRecipes.Count == 0)
            {
                <p class="discovery-empty" id="homeTopRatedEmpty">Chưa có công thức nào được đánh giá.</p>
            }
        </div>
    </div>
</section>
<section class="community-strip container">
    <div class="community-illustration" aria-hidden="true">🥑<span>✦</span>🥕</div>
    <div><span class="eyebrow">BÍ QUYẾT NGON, ĐỪNG GIỮ RIÊNG</span><h2>Công thức của bạn, cảm hứng của ai đó.</h2><p>Một món ăn quen cũng có thể bắt đầu một câu chuyện mới.</p></div>
    <a class="btn" href="/Recipe/Create"><svg class="icon"><use href="#i-plus" /></svg> Chia sẻ công thức</a>
</section>
<section class="section community-authors" aria-labelledby="communityHeading"><div class="container">
    <div class="section-heading"><div><span class="eyebrow">NHỮNG NGƯỜI BẠN CÙNG ĐAM MÊ</span><h2 id="communityHeading">Cùng nhau, thêm yêu bếp</h2><p>Ghé thăm những căn bếp và kết nối với cộng đồng.</p></div></div>
    <div class="user-cards-grid" id="homeCommunityUsers">
        @foreach (var member in Model.CommunityUsers)
        {
            <article class="user-card">
                <div class="user-card-left">
                    <a asp-controller="Profile" asp-action="Index" asp-route-userId="@member.UserId" aria-label="Ghé thăm căn bếp @member.DisplayName">
                        @if (!string.IsNullOrWhiteSpace(member.AvatarUrl))
                        {
                            <img class="user-card-avatar" src="@RecipeImageReference.GetSource(member.AvatarUrl)" alt="Ảnh đại diện @member.DisplayName" width="52" height="52" loading="lazy" />
                        }
                        else
                        {
                            <span class="user-card-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(member.DisplayName) ? "CS" : member.DisplayName[..1].ToUpperInvariant())</span>
                        }
                    </a>
                    <div class="user-card-info">
                        <h3 class="user-card-name"><a asp-controller="Profile" asp-action="Index" asp-route-userId="@member.UserId">@member.DisplayName</a></h3>
                        <p class="user-card-username">@("@" + member.UserName)</p>
                    </div>
                </div>
                <a class="text-link" asp-controller="Profile" asp-action="Index" asp-route-userId="@member.UserId">Ghé thăm căn bếp <svg class="icon"><use href="#i-arrow" /></svg></a>
            </article>
        }
        @if (Model.CommunityUsers.Count == 0)
        {
            <p>Những người bạn yêu bếp sẽ xuất hiện khi chia sẻ công thức đầu tiên.</p>
        }
    </div>
</div></section>
<section class="section latest" aria-labelledby="latestHeading">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">THÊM MỘT CHÚT MỚI MẺ</span><h2 id="latestHeading">Từ những căn bếp thân quen</h2></div><a class="text-link" href="/Recipe">Xem tất cả <svg class="icon"><use href="#i-arrow" /></svg></a></div>
        <div class="@(Model.LatestRecipes.Count == 0 ? "" : "recipe-grid")" id="homeLatestGrid">
            @foreach (var recipe in Model.LatestRecipes)
            {
                <partial name="_RecipeCard" model="recipe" />
            }
            @if (Model.LatestRecipes.Count == 0)
            {
                <partial name="_RecipeEmpty" />
            }
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-interactions.js" asp-append-version="true"></script>
    <script src="~/js/recipe-actions.js" asp-append-version="true"></script>
}
