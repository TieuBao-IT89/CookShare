

<link rel="stylesheet"
      href="~/css/style.css"
      asp-append-version="true" />

<main class="feed-page">

    <div class="container">

        <div class="feed-layout">

            <!-- ================================
                 SIDEBAR TRÁI
                 ================================ -->

            <aside class="sidebar">

                <div class="profile-mini">

                    <div class="avatar">
                        CS
                    </div>

                    <h3>CookShare</h3>

                    <p>Cộng đồng yêu nấu ăn</p>

                </div>


                <div class="side-menu">

                    <a class="active"
                       href="@Url.Action("Index", "Home")">

                        <span class="side-icon">⌂</span>
                        <span>Bảng tin</span>

                    </a>


                    <a href="/Recipe">

                        <span class="side-icon">⌕</span>
                        <span>Khám phá công thức</span>

                    </a>


                    <a href="/Recipe/Create">

                        <span class="side-icon">+</span>
                        <span>Thêm công thức</span>

                    </a>


                    <a href="#categories">

                        <span class="side-icon">□</span>
                        <span>Danh mục</span>

                    </a>


                    <a href="#">

                        <span class="side-icon">♡</span>
                        <span>Công thức yêu thích</span>

                    </a>


                    <a href="@Url.Action("Index", "Profile")">

                        <span class="side-icon">○</span>
                        <span>Trang cá nhân</span>

                    </a>

                </div>

            </aside>



            <!-- ================================
                 BẢNG TIN CHÍNH
                 ================================ -->

            <section class="feed">

                <div class="feed-header">

                    <h1>Bảng tin CookShare</h1>

                    <p>
                        Khám phá những công thức mới nhất từ cộng đồng
                    </p>

                </div>



                <!-- ================================
                     TẠO BÀI ĐĂNG
                     ================================ -->

                <div class="create-post">

                    <div class="create-post-top">

                        <div class="create-avatar">
                            CS
                        </div>


                        <a href="/Recipe/Create"
                           class="create-input">

                            Bạn đang muốn chia sẻ món gì hôm nay?

                        </a>

                    </div>


                    <div class="create-post-bottom">

                        <a href="/Recipe/Create"
                           class="create-option">

                            + Ảnh món ăn

                        </a>


                        <a href="/Recipe/Create"
                           class="create-option">

                            + Công thức

                        </a>


                        <a href="/Recipe/Create"
                           class="create-option">

                            ↗ Chia sẻ

                        </a>

                    </div>

                </div>



                <!-- ================================
                     BÀI ĐĂNG 1
                     ================================ -->

                <article class="recipe-post">

                    <div class="post-header">

                        <div class="post-avatar">
                            NA
                        </div>


                        <div class="post-user">

                            <strong>
                                Nguyễn Văn An
                            </strong>

                            <span>
                                1.2K người theo dõi · 2 giờ trước
                            </span>

                        </div>


                        <span class="post-menu">
                            ⋯
                        </span>

                    </div>


                    <div class="post-content">

                        <!-- Danh mục nhỏ -->

                        <span style="
                            display:block;
                            font-size:12px;
                            color:#6f7c73;
                            margin-bottom:4px;
                            font-weight:500;
                        ">
                            Món Việt
                        </span>


                        <!-- Tên món -->

                        <h2 class="post-title"
                            style="
                                font-size:19px;
                                margin-top:0;
                                margin-bottom:7px;
                            ">

                            Phở bò Hà Nội

                        </h2>


                        <p class="post-description">

                            Một tô phở bò truyền thống với nước dùng trong,
                            đậm đà, thơm mùi quế hồi và thịt bò mềm ngon.
                            Đây là công thức mình thường nấu cho gia đình
                            vào cuối tuần.

                        </p>

                    </div>


                    <img class="post-image"
                         src="https://images.unsplash.com/photo-1582878826629-29b7ad1cdc43?auto=format&fit=crop&w=1200&q=85"
                         alt="Phở bò Hà Nội" />


                    <div class="post-info">

                        <span>★ 4.9</span>

                        <span>♡ 321 lượt thích</span>

                        <span>○ 48 bình luận</span>

                    </div>


                    <div class="post-actions">

                        <button type="button"
                                class="post-action">

                            ♡ Thích

                        </button>


                        <button type="button"
                                class="post-action">

                            ○ Bình luận

                        </button>


                        <button type="button"
                                class="post-action">

                            ↗ Chia sẻ

                        </button>

                    </div>


                    <a class="details-button"
                       href="/Recipe/Details/1">

                        Xem chi tiết công thức →

                    </a>

                </article>



                <!-- ================================
                     BÀI ĐĂNG 2
                     ================================ -->

                <article class="recipe-post">

                    <div class="post-header">

                        <div class="post-avatar">
                            MA
                        </div>


                        <div class="post-user">

                            <strong>
                                Trần Minh Anh
                            </strong>

                            <span>
                                860 người theo dõi · 5 giờ trước
                            </span>

                        </div>


                        <span class="post-menu">
                            ⋯
                        </span>

                    </div>


                    <div class="post-content">

                        <span style="
                            display:block;
                            font-size:12px;
                            color:#6f7c73;
                            margin-bottom:4px;
                            font-weight:500;
                        ">
                            Tráng miệng
                        </span>


                        <h2 class="post-title"
                            style="
                                font-size:19px;
                                margin-top:0;
                                margin-bottom:7px;
                            ">

                            Bánh Tiramisu mềm mịn

                        </h2>


                        <p class="post-description">

                            Tiramisu với lớp kem mềm, vị cà phê nhẹ
                            và phần bánh thơm béo. Công thức đơn giản,
                            phù hợp để làm món tráng miệng tại nhà.

                        </p>

                    </div>


                    <img class="post-image"
                         src="https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?auto=format&fit=crop&w=1200&q=85"
                         alt="Bánh Tiramisu" />


                    <div class="post-info">

                        <span>★ 4.8</span>

                        <span>♡ 214 lượt thích</span>

                        <span>○ 31 bình luận</span>

                    </div>


                    <div class="post-actions">

                        <button type="button"
                                class="post-action">

                            ♡ Thích

                        </button>


                        <button type="button"
                                class="post-action">

                            ○ Bình luận

                        </button>


                        <button type="button"
                                class="post-action">

                            ↗ Chia sẻ

                        </button>

                    </div>


                    <a class="details-button"
                       href="/Recipe/Details/2">

                        Xem chi tiết công thức →

                    </a>

                </article>



                <!-- ================================
                     BÀI ĐĂNG 3
                     ================================ -->

                <article class="recipe-post">

                    <div class="post-header">

                        <div class="post-avatar">
                            LN
                        </div>


                        <div class="post-user">

                            <strong>
                                Lê Hoàng Nam
                            </strong>

                            <span>
                                2.4K người theo dõi · 1 ngày trước
                            </span>

                        </div>


                        <span class="post-menu">
                            ⋯
                        </span>

                    </div>


                    <div class="post-content">

                        <span style="
                            display:block;
                            font-size:12px;
                            color:#6f7c73;
                            margin-bottom:4px;
                            font-weight:500;
                        ">
                            Món Việt
                        </span>


                        <h2 class="post-title"
                            style="
                                font-size:19px;
                                margin-top:0;
