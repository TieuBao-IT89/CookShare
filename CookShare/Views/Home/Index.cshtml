@model CookShare.ViewModels.HomeIndexViewModel
@using CookShare.Helpers
@{
    ViewData["Title"] = Model.Feed.Mode == "following" ? "Căn bếp bạn theo dõi" : "Bảng tin món ngon";
    var following = Model.Feed.Mode == "following";
    var profile = Model.CurrentProfile;
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Following", "Home") });
    var categories = new[] { ("fa-bowl-food", "Món Việt"), ("fa-bowl-rice", "Món Á"), ("fa-pizza-slice", "Món Âu"), ("fa-leaf", "Món chay"), ("fa-cake-candles", "Món tráng miệng"), ("fa-martini-glass-citrus", "Đồ uống") };
}
@section Styles {
    <link rel="stylesheet" href="~/css/recipe-saved.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-likes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-comments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recipe-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-feed.css" asp-append-version="true" />
}
<div class="home-feed" data-home-feed data-mode="@Model.Feed.Mode" data-viewer-id="@Model.Feed.ViewerId" data-login-url="@loginUrl"
     data-more-path="@Url.Action("More", "Home")" data-home-path="@Url.Action("Index", "Home")">
    <div class="feed-shell">
        <aside class="feed-left" aria-label="Lối tắt của bạn">
            <div class="feed-sticky">
                <a class="feed-identity" asp-controller="Profile" asp-action="Index">
                    <span class="feed-identity-avatar">
                        @if (!string.IsNullOrWhiteSpace(profile?.AvatarUrl) && RecipeImageReference.IsValid(profile.AvatarUrl))
                        {
                            <img src="@RecipeImageReference.GetSource(profile.AvatarUrl)" alt="" width="48" height="48" />
                        }
                        else
                        {
                            <i class="icon fa-solid fa-utensils" aria-hidden="true"></i>
                        }
                    </span>
                    <span><strong>@(profile?.Name ?? "Một căn bếp mới")</strong><small>@(profile == null ? "Bắt đầu câu chuyện của bạn" : $"{profile.RecipeCount} công thức đã chia sẻ")</small></span>
                </a>
                <nav class="feed-shortcuts" aria-label="Bảng tin và bộ sưu tập">
                    <a class="@(!following ? "is-current" : "")" asp-controller="Home" asp-action="Index" aria-current="@(!following ? "page" : null)"><i class="icon fa-solid fa-house" aria-hidden="true"></i> Bảng tin món ngon</a>
                    <a class="@(following ? "is-current" : "")" asp-controller="Home" asp-action="Following" aria-current="@(following ? "page" : null)"><i class="icon fa-solid fa-users" aria-hidden="true"></i> Đang theo dõi @if (profile != null) { <span class="feed-nav-count">@profile.FollowingCount</span> }</a>
                    <a asp-controller="Recipe" asp-action="Saved"><i class="icon fa-regular fa-bookmark" aria-hidden="true"></i> Công thức đã lưu</a>
                    <a asp-controller="Recipe" asp-action="Index"><i class="icon fa-solid fa-compass" aria-hidden="true"></i> Khám phá thêm</a>
                </nav>
                <div class="feed-categories">
                    <span class="feed-section-label">ĐỔI VỊ MỖI NGÀY</span>
                    @foreach (var (categoryIcon, category) in categories)
                    {
                        <a asp-controller="Recipe" asp-action="Index" asp-route-category="@category"><i class="icon fa-solid @categoryIcon" aria-hidden="true"></i>@category</a>
                    }
                </div>
                <div class="feed-left-note"><i class="icon fa-regular fa-heart" aria-hidden="true"></i><p>Món ngon hơn<br />khi được sẻ chia.</p></div>
            </div>
        </aside>

        <div class="feed-main">
            <section class="feed-welcome" aria-labelledby="feedWelcomeTitle">
                <div><span class="eyebrow">MỘT CHÚT CẢM HỨNG, MỖI NGÀY</span><h1 id="feedWelcomeTitle">Hôm nay, <em>bếp có gì?</em></h1><p>Ghé những căn bếp thân quen, tìm món ngon cho bữa ăn tiếp theo.</p></div>
                <span class="feed-welcome-art" aria-hidden="true"><i class="icon fa-solid fa-leaf" aria-hidden="true"></i><span class="feed-welcome-spark"><i class="fa-solid fa-star"></i></span></span>
            </section>

            <nav class="feed-category-chips" id="categories" aria-label="Khám phá danh mục món ăn">
                @foreach (var (categoryIcon, category) in categories)
                {
                    <a asp-controller="Recipe" asp-action="Index" asp-route-category="@category"><i class="icon fa-solid @categoryIcon" aria-hidden="true"></i>@category</a>
                }
            </nav>

            <section class="feed-composer" aria-label="Chia sẻ công thức">
                <div class="feed-composer-top">
                    <span class="feed-avatar" aria-hidden="true"><i class="icon fa-solid fa-utensils" aria-hidden="true"></i></span>
                    <a asp-controller="Recipe" asp-action="Create">@(profile == null ? "Bạn vừa nấu một món ngon?" : $"{profile.Name}, hôm nay bạn nấu gì?")</a>
                    <a class="feed-composer-add" asp-controller="Recipe" asp-action="Create" aria-label="Đăng công thức mới"><i class="icon fa-solid fa-plus" aria-hidden="true"></i></a>
                </div>
                <div class="feed-composer-bottom"><span><i class="icon fa-regular fa-image" aria-hidden="true"></i> Chia sẻ hương vị, kể chuyện căn bếp</span><a asp-controller="Recipe" asp-action="Create">Đăng công thức <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
            </section>

            <section class="feed-stream" aria-labelledby="feedHeading">
                <div class="feed-stream-toolbar">
                    <nav class="feed-tabs" aria-label="Chọn bảng tin">
                        <a class="@(!following ? "is-active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(!following ? "page" : null)"><i class="icon fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Mới nhất</a>
                        <a class="@(following ? "is-active" : "")" asp-controller="Home" asp-action="Following" aria-current="@(following ? "page" : null)"><i class="icon fa-solid fa-users" aria-hidden="true"></i> Đang theo dõi</a>
                    </nav>
                    <label class="feed-auto" hidden data-feed-auto-control><input type="checkbox" data-feed-auto checked /> Tự tải thêm</label>
                </div>
                <div class="feed-stream-heading"><h2 id="feedHeading">@(following ? "Từ những căn bếp bạn theo dõi" : "Món mới từ cộng đồng")</h2><span>Chia sẻ mới nhất</span></div>
                <div id="homeFeedItems" data-feed-items aria-busy="false">
                    <partial name="_FeedBatch" model="Model.Feed" />
                </div>
                @if (Model.Feed.Recipes.Count == 0)
                {
                    <div class="feed-empty">
                        <span class="feed-empty-icon" aria-hidden="true"><i class="icon fa-solid @(following ? "fa-users" : "fa-utensils")"></i></span>
                        <h3>@(following ? "Kết nối thêm, căn bếp vui hơn" : "Câu chuyện đầu tiên bắt đầu từ bạn")</h3>
                        <p>@(following ? "Chưa có công thức nào từ những người bạn đang theo dõi. Ghé trang cá nhân một người yêu bếp và nhấn Theo dõi để đón món mới ở đây." : "Chưa có công thức nào được chia sẻ. Hãy mang món ngon đầu tiên đến với cộng đồng.")</p>
                        <a class="btn" asp-controller="Recipe" asp-action="@(following ? "Index" : "Create")">@(following ? "Khám phá những căn bếp" : "Chia sẻ công thức đầu tiên") <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                }
                <div class="feed-loading" data-feed-loading hidden aria-hidden="true"><span></span><span></span><span></span></div>
                <p class="feed-status" data-feed-status role="status" aria-live="polite"></p>
                <div class="feed-pagination" data-feed-pagination>
                    @if (Model.Feed.NextCursor != null)
                    {
                        <a class="btn btn-secondary" data-feed-more
                           href="@Url.Action("Index", "Home", new { feed = Model.Feed.Mode, cursor = Model.Feed.NextCursor })"
                           data-endpoint="@Url.Action("More", "Home", new { feed = Model.Feed.Mode, cursor = Model.Feed.NextCursor })">Xem thêm món ngon <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    }
                    <p class="feed-end" data-feed-end hidden="@(Model.Feed.NextCursor != null || Model.Feed.Recipes.Count == 0)"><span aria-hidden="true">✦</span> Bạn đã xem hết những món mới. Hẹn bạn ở bữa ăn tiếp theo!</p>
                </div>
                <div class="feed-sentinel" data-feed-sentinel aria-hidden="true"></div>
            </section>
        </div>

        <aside class="feed-right" aria-label="Cảm hứng từ cộng đồng">
            <div class="feed-sticky">
                <section class="feed-side-card feed-spotlight" id="homeFeaturedGrid" aria-labelledby="spotlightHeading">
                    <div class="feed-side-heading"><span class="feed-section-label">ĐÁNG THỬ HÔM NAY</span><i class="icon fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></div>
                    <h2 id="spotlightHeading">Một món ngon,<br /><em>thêm một niềm vui.</em></h2>
                    @foreach (var recipe in Model.FeaturedRecipes)
                    {
                        <a class="feed-mini-recipe" asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id" data-recipe-id="@recipe.Id">
                            <img src="@RecipeImageReference.GetSource(recipe.Image)" alt="" width="64" height="64" loading="lazy" />
                            <span><strong>@recipe.Name</strong><small>@recipe.Category</small></span><i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                    @if (Model.FeaturedRecipes.Count == 0)
                    {
                        <p class="feed-side-muted">Chưa có món nổi bật. Mỗi lượt thích của bạn sẽ mang một món ngon đến gần cộng đồng hơn.</p>
                        <a class="text-link" asp-controller="Recipe" asp-action="Index">Tìm món hợp gu <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    }
                </section>
                <section class="feed-side-card" id="homeCommunityUsers" aria-labelledby="feedCommunityHeading">
                    <span class="feed-section-label">LÀM QUEN MỘT CĂN BẾP</span><h2 id="feedCommunityHeading">Cùng nhau yêu bếp</h2>
                    @foreach (var member in Model.CommunityUsers)
                    {
                        <a class="feed-member" asp-controller="Profile" asp-action="Index" asp-route-userId="@member.UserId">
                            <span class="feed-avatar">
                                @if (!string.IsNullOrWhiteSpace(member.AvatarUrl))
                                {
                                    <img src="@RecipeImageReference.GetSource(member.AvatarUrl)" alt="" width="40" height="40" loading="lazy" />
                                }
                                else
                                {
                                    <i class="icon fa-regular fa-user" aria-hidden="true"></i>
                                }
                            </span>
                            <span><strong>@member.DisplayName</strong><small>@("@" + member.UserName)</small></span><span class="feed-member-visit">Ghé bếp</span>
                        </a>
                    }
                    @if (Model.CommunityUsers.Count == 0)
                    {
                        <p class="feed-side-muted">Những người bạn yêu bếp sẽ xuất hiện khi chia sẻ công thức đầu tiên.</p>
                    }
                </section>
                <section class="feed-side-card feed-discovery" aria-label="Khám phá công thức nổi bật">
                    <details id="homePopularGrid"><summary><i class="icon fa-regular fa-heart" aria-hidden="true"></i> Được yêu thích</summary>
                        @foreach (var recipe in Model.PopularRecipes)
                        {
                            <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id" data-recipe-id="@recipe.Id">@recipe.Name <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        }
                        @if (Model.PopularRecipes.Count == 0) { <p class="feed-side-muted">Chưa có công thức nào được yêu thích.</p> }
                    </details>
                    <details id="homeTopRatedGrid"><summary><i class="icon fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Đánh giá cao</summary>
                        @foreach (var recipe in Model.TopRatedRecipes)
                        {
                            <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id" data-recipe-id="@recipe.Id">@recipe.Name <i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        }
                        @if (Model.TopRatedRecipes.Count == 0) { <p class="feed-side-muted">Chưa có công thức nào được đánh giá.</p> }
                    </details>
                </section>
                <p class="feed-side-signoff">Từ căn bếp, đến trái tim. <i class="fa-regular fa-heart" aria-hidden="true"></i></p>
            </div>
        </aside>
    </div>
    <button class="feed-back-top" data-feed-top type="button" aria-label="Về đầu bảng tin" hidden><i class="icon fa-solid fa-arrow-right" aria-hidden="true"></i><span>Về đầu</span></button>
    <dialog class="feed-share-dialog" data-feed-share-dialog aria-labelledby="feedShareTitle">
        <form method="dialog" asp-antiforgery="false"><h2 id="feedShareTitle">Gửi một chút cảm hứng</h2><p>Chọn và sao chép liên kết để chia sẻ món ngon này.</p><label for="feedShareUrl">Liên kết công thức</label><input id="feedShareUrl" type="url" readonly /><button class="btn" value="close">Đóng</button></form>
    </dialog>
</div>
@section Scripts {
    <script src="~/js/recipe-saved.js" asp-append-version="true"></script>
    <script src="~/js/recipe-interactions.js" asp-append-version="true"></script>
    <script src="~/js/home-feed.js" asp-append-version="true"></script>
}
