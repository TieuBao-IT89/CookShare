<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           LẤY ELEMENT
        ===================================================== */

        const searchForm =
            document.getElementById("searchForm");

        const searchInput =
            document.getElementById("searchInput");

        const categoryResults =
            document.getElementById("categoryResults");

        const resultEyebrow =
            document.getElementById("resultEyebrow");

        const searchTitle =
            document.getElementById("searchTitle");

        const searchMessage =
            document.getElementById("searchMessage");

        const searchResultGrid =
            document.getElementById("searchResultGrid");

        const categoryCards =
            document.querySelectorAll(".category-card");

        const allRecipeCards =
            document.querySelectorAll(
                ".featured .recipe-card, .latest .recipe-card"
            );

        const latestRecipeGrid =
            document.getElementById("latestRecipeGrid");

        const filterButtons =
            document.querySelectorAll(".filter");

        const loadMoreButton =
            document.getElementById("loadMore");


        /* =====================================================
           BỎ DẤU TIẾNG VIỆT
        ===================================================== */

        function removeVietnameseDiacritics(text) {

            return text
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d")
                .replace(/Đ/g, "D")
                .toLowerCase()
                .trim();

        }


        /* =====================================================
           HIỆN TẤT CẢ
        ===================================================== */

        function showAllRecipes() {

            allRecipeCards.forEach(function (card) {

                card.style.display = "";

            });

        }


        /* =====================================================
           ẨN KẾT QUẢ
        ===================================================== */

        function hideResults() {

            categoryResults.style.display = "none";

            searchResultGrid.innerHTML = "";

        }


        /* =====================================================
           HIỆN KẾT QUẢ
        ===================================================== */

        function showResults(title, message, cards) {

            searchResultGrid.innerHTML = "";

            cards.forEach(function (card) {

                const clone =
                    card.cloneNode(true);

                // QUAN TRỌNG:
                // Card gốc có thể đang bị ẩn bằng style="display:none".
                // cloneNode() sao chép cả inline style đó, khiến kết quả
                // tìm kiếm/danh mục cũng bị ẩn.
                // Xóa trạng thái ẩn trên bản sao trước khi đưa vào kết quả.
                clone.style.display = "";

                searchResultGrid.appendChild(clone);

            });

            searchTitle.textContent = title;

            searchMessage.textContent = message;

            categoryResults.style.display = "block";

        }


        /* =====================================================
           TÌM KIẾM
        ===================================================== */

        if (searchForm) {

            searchForm.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const keyword =
                        searchInput.value.trim();


                    if (keyword === "") {

                        hideResults();

                        showAllRecipes();

                        document
                            .getElementById("featured")
                            .scrollIntoView({
                                behavior: "smooth"
                            });

                        return;

                    }


                    const normalizedKeyword =
                        removeVietnameseDiacritics(
                            keyword
                        );


                    const foundCards = [];


                    allRecipeCards.forEach(
                        function (card) {

                            const titleElement =
                                card.querySelector(
                                    ".recipe-title-row h3"
                                );


                            if (!titleElement) {
                                return;
                            }


                            const recipeName =
                                titleElement.textContent.trim();


                            const normalizedName =
                                removeVietnameseDiacritics(
                                    recipeName
                                );


                            if (
                                normalizedName.includes(
                                    normalizedKeyword
                                )
                            ) {

                                foundCards.push(card);

                            }

                        }
                    );


                    // Ẩn các card gốc
                    allRecipeCards.forEach(
                        function (card) {
                            card.style.display = "none";
                        }
                    );


                    if (foundCards.length > 0) {

                        resultEyebrow.textContent =
                            "KẾT QUẢ TÌM KIẾM";

                        showResults(
                            "Kết quả tìm kiếm",
                            `Tìm thấy ${foundCards.length} công thức phù hợp với "${keyword}".`,
                            foundCards
                        );

                    }
                    else {

                        resultEyebrow.textContent =
                            "KẾT QUẢ TÌM KIẾM";

                        showResults(
                            "Không tìm thấy công thức",
                            `Không tìm thấy công thức nào phù hợp với "${keyword}".`,
                            []
                        );

                    }


                    categoryResults.style.display = "block";

                    categoryResults.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                }
            );

        }


        /* =====================================================
           LỌC THEO DANH MỤC
        ===================================================== */

        categoryCards.forEach(
            function (categoryCard) {

                categoryCard.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();


                        const selectedCategory =
                            categoryCard.dataset.category;


                        const foundCards = [];


                        allRecipeCards.forEach(
                            function (card) {

                                const category =
                                    card.dataset.category;


                                if (
                                    category ===
                                    selectedCategory
                                ) {

                                    foundCards.push(card);

                                }

                                card.style.display =
                                    "none";

                            }
                        );


                        searchInput.value = "";


                        resultEyebrow.textContent =
                            "DANH MỤC MÓN ĂN";


                        showResults(
                            selectedCategory,
                            `Tìm thấy ${foundCards.length} công thức thuộc danh mục "${selectedCategory}".`,
                            foundCards
                        );

                        // Đảm bảo kết quả vừa lọc luôn hiển thị.
                        categoryResults.style.display = "block";

                        categoryResults.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                    }
                );

            }
        );


        /* =====================================================
           BỘ LỌC MỚI NHẤT / PHỔ BIẾN / YÊU THÍCH
        ===================================================== */

        filterButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        filterButtons.forEach(
                            function (item) {
                                item.classList.remove("active");
                            }
                        );


                        button.classList.add("active");


                        const sortType =
                            button.dataset.sort;


                        const cards =
                            Array.from(
                                latestRecipeGrid
                                    .querySelectorAll(
                                        ".recipe-card"
                                    )
                            );


                        if (sortType === "popular") {

                            cards.sort(
                                function (a, b) {

                                    return (
                                        Number(
                                            b.dataset.popular
                                        ) -
                                        Number(
                                            a.dataset.popular
                                        )
                                    );

                                }
                            );

                        }


                        else if (
                            sortType === "favorite"
                        ) {

                            // "Được yêu thích" nên dựa vào số lượt thích,
                            // không phải điểm rating (vì các món hiện đều 4.9).
                            cards.sort(
                                function (a, b) {

                                    return (
                                        Number(
                                            b.dataset.popular || 0
                                        ) -
                                        Number(
                                            a.dataset.popular || 0
                                        )
                                    );

                                }
                            );

                        }


                        else {

                            cards.sort(
                                function (a, b) {

                                    return (
                                        Number(
                                            a.dataset.order
                                        ) -
                                        Number(
                                            b.dataset.order
                                        )
                                    );

                                }
                            );

                        }


                        cards.forEach(
                            function (card) {

                                latestRecipeGrid
                                    .appendChild(card);

                            }
                        );

                    }
                );

            }
        );


        /* =====================================================
           NÚT XEM THÊM
        ===================================================== */

        if (loadMoreButton) {

            loadMoreButton.addEventListener(
                "click",
                function () {

                    alert(
                        "CookShare sẽ cập nhật thêm nhiều công thức trong phiên bản tiếp theo!"
                    );

                }
            );

        }


        /* =====================================================
           LIKE
        ===================================================== */

        document.addEventListener(
            "click",
            function (event) {

                const likeButton =
                    event.target.closest(".like");


                if (!likeButton) {
                    return;
                }


                event.preventDefault();


                likeButton.classList.toggle("liked");


                if (
                    likeButton.classList.contains(
                        "liked"
                    )
                ) {

                    likeButton.textContent = "♥";

                }
                else {

                    likeButton.textContent = "♡";

                }

            }
        );


        /* =====================================================
           XÓA TÌM KIẾM BẰNG ESC
        ===================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        searchInput.value = "";

                        hideResults();

                        showAllRecipes();

                    }

                }
            );

        }


        /* =====================================================
           CLICK LOGO / TRANG CHỦ
        ===================================================== */

        document
            .querySelectorAll(
                'a[href="#top"]'
            )
            .forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            searchInput.value = "";

                            hideResults();

                            showAllRecipes();

                        }
                    );

                }
            );


        /* =====================================================
           CLICK "XEM TẤT CẢ"
        ===================================================== */

        const viewAll =
            document.getElementById(
                "viewAllFeatured"
            );


        if (viewAll) {

            viewAll.addEventListener(
                "click",
                function () {

                    searchInput.value = "";

                    hideResults();

                    showAllRecipes();

                }
            );

        }


        /* =====================================================
           MENU MOBILE
        ===================================================== */

        const menuButton =
            document.querySelector(".menu-btn");

        const navLinks =
            document.querySelector(".nav-links");


        if (
            menuButton &&
            navLinks
        ) {

            menuButton.addEventListener(
                "click",
                function () {

                    navLinks.classList.toggle(
                        "open"
                    );

                }
            );

        }


        /* =====================================================
           KIỂM TRA
        ===================================================== */

        console.log(
            "CookShare Index đã tải thành công."
        );

        console.log(
            "Số công thức:",
            allRecipeCards.length
        );

        console.log(
            "Số danh mục:",
            categoryCards.length
        );

    });

</script>