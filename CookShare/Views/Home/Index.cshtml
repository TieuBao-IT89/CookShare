@{
    ViewData["Title"] = "Home Page";
}

<header class="site-header">
    <div class="container nav">
      <a class="logo" href="#top">♨ <span>Cook<span>Share</span></span></a>
      <button class="menu-btn" aria-label="Mở menu">☰</button>
      <nav class="nav-links">
        <a class="active" href="#top">Trang chủ</a><a href="#featured">Công thức</a><a href="#categories">Danh mục</a><a href="#share">Chia sẻ công thức</a>
      </nav>
        <div class="nav-actions"><label class="search"><input type="search" placeholder="Tìm kiếm công thức món ăn..." />⌕</label><a class="login" href="@Url.Action("Username", "Home")">Đăng nhập</a><a class="btn btn-small" href="#signup">Đăng ký</a></div>
    </div>
  </header>

  <main>
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">CỘNG ĐỒNG ẨM THỰC VIỆT</span>
          <h1>Khám phá hương vị,<br /><em>chia sẻ đam mê</em></h1>
          <p>Từ căn bếp nhỏ đến những bữa ăn thật đáng nhớ. Hơn 10.000 công thức ngon đang chờ bạn khám phá tại CookShare.</p>
          <div class="hero-buttons"><a class="btn" href="#featured">Khám phá công thức →</a><a class="btn btn-outline" href="/Recipe/Create">Chia sẻ công thức</a></div>
          <div class="hero-stats"><div><strong>10K<span>+</span></strong><small>Công thức</small></div><div><strong>25K<span>+</span></strong><small>Thành viên</small></div><div><strong>4.8 ★</strong><small>Đánh giá cộng đồng</small></div></div>
        </div>
        <div class="hero-photo-wrap"><div class="hero-blob"></div><img class="hero-photo" src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=90" alt="Bàn ăn với các món ăn tươi ngon" /><div class="floating-card"><span>🍲</span><div><b>Hôm nay ăn gì?</b><small>Khám phá 120+ món mới</small></div></div></div>
      </div>
    </section>

    <section class="section categories" id="categories">
      <div class="container">
        <div class="section-heading centered"><span class="eyebrow">KHÁM PHÁ THEO GU</span><h2>Danh mục món ăn</h2><p>Dễ dàng tìm công thức phù hợp với sở thích của bạn.</p></div>
        <div class="category-grid">
          <a class="category-card" href="#latest"><span class="category-emoji">🍜</span><div><h3>Món Việt</h3><p>124 công thức</p></div><span class="card-arrow">→</span></a>
          <a class="category-card" href="#latest"><span class="category-emoji">🥢</span><div><h3>Món Á</h3><p>98 công thức</p></div><span class="card-arrow">→</span></a>
          <a class="category-card" href="#latest"><span class="category-emoji">🍝</span><div><h3>Món Âu</h3><p>76 công thức</p></div><span class="card-arrow">→</span></a>
          <a class="category-card" href="#latest"><span class="category-emoji">🥗</span><div><h3>Món chay</h3><p>64 công thức</p></div><span class="card-arrow">→</span></a>
          <a class="category-card" href="#latest"><span class="category-emoji">🍰</span><div><h3>Tráng miệng</h3><p>82 công thức</p></div><span class="card-arrow">→</span></a>
          <a class="category-card" href="#latest"><span class="category-emoji">🧋</span><div><h3>Đồ uống</h3><p>47 công thức</p></div><span class="card-arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section featured" id="featured">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">ĐƯỢC YÊU THÍCH NHẤT</span><h2>Công thức nổi bật</h2><p>Những món ăn đang được cộng đồng CookShare yêu thích.</p></div><a class="text-link" href="/Recipe">Xem tất cả →</a></div>
        <div class="featured-grid" id="homeFeaturedGrid">
          <!-- Danh sách công thức nổi bật sẽ được render tự động từ localStorage cookshare_recipes -->
        </div>
      </div>
    </section>

    <section class="section latest" id="latest">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">MỚI VỪA RA LÒ</span><h2>Công thức mới nhất</h2></div><div class="filters"><button class="filter active" data-filter="latest" type="button">Mới nhất</button><button class="filter" data-filter="popular" type="button">Phổ biến</button><button class="filter" data-filter="favorite" type="button">Được yêu thích</button></div></div>
        <div class="recipe-grid" id="homeLatestGrid">
          <!-- Danh sách công thức mới nhất sẽ được render tự động từ localStorage cookshare_recipes -->
        </div><button class="load-more" id="btnLoadMoreHome" type="button">Xem thêm công thức →</button>
      </div>
    </section>
    <section class="cta" id="share"><div class="container cta-inner"><div><span class="eyebrow">CÙNG NHAU VÀO BẾP</span><h2>Bạn có công thức ngon?</h2><p>Chia sẻ công thức của bạn với cộng đồng CookShare.</p></div><a class="btn" href="/Recipe/Create">Chia sẻ công thức ngay →</a><span class="cta-decor">✦</span></div></section>
  </main>

@section Scripts {
    <script src="~/js/recipe.js" asp-append-version="true"></script>
}