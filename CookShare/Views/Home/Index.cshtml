@{
    ViewData["Title"] = "CookShare - Chia sẻ công thức";
}

<!-- =========================================================
     HEADER
========================================================= -->

<header class="site-header">
    <div class="container nav">

        <a class="logo" href="#top">
            ♨
            <span>
                Cook<span>Share</span>
            </span>
        </a>

        <button class="menu-btn"
                type="button"
                aria-label="Mở menu">
            ☰
        </button>

        <nav class="nav-links">

            <a class="active" href="#top">
                Trang chủ
            </a>

            <a href="#featured">
                Công thức
            </a>

            <a href="#categories">
                Danh mục
            </a>

            <a href="#share">
                Chia sẻ công thức
            </a>

        </nav>

        <div class="nav-actions">

            <form class="search" id="searchForm">

                <input type="search"
                       id="searchInput"
                       placeholder="Tìm kiếm công thức món ăn..."
                       autocomplete="off" />

                <button type="submit"
                        aria-label="Tìm kiếm">
                    ⌕
                </button>

            </form>

            <a class="login" href="#login">
                Đăng nhập
            </a>

            <a class="btn btn-small" href="#signup">
                Đăng ký
            </a>

        </div>

    </div>
</header>


<!-- =========================================================
     MAIN
========================================================= -->

<main id="top">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

        <div class="container hero-grid">

            <div class="hero-copy">

                <span class="eyebrow">
                    CỘNG ĐỒNG ẨM THỰC VIỆT
                </span>

                <h1>
                    Khám phá hương vị,
                    <br />
                    <em>chia sẻ đam mê</em>
                </h1>

                <p>
                    Từ căn bếp nhỏ đến những bữa ăn thật đáng nhớ.
                    Hơn 10.000 công thức ngon đang chờ bạn khám phá
                    tại CookShare.
                </p>

                <div class="hero-buttons">

                    <a class="btn" href="#featured">
                        Khám phá công thức →
                    </a>

                    <a class="btn btn-outline" href="#share">
                        Chia sẻ công thức
                    </a>

                </div>

                <div class="hero-stats">

                    <div>
                        <strong>
                            10K<span>+</span>
                        </strong>

                        <small>
                            Công thức
                        </small>
                    </div>

                    <div>
                        <strong>
                            25K<span>+</span>
                        </strong>

                        <small>
                            Thành viên
                        </small>
                    </div>

                    <div>
                        <strong>
                            4.8 ★
                        </strong>

                        <small>
                            Đánh giá cộng đồng
                        </small>
                    </div>

                </div>

            </div>


            <div class="hero-photo-wrap">

                <div class="hero-blob"></div>

                <img class="hero-photo"
                     src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=90"
                     alt="Bàn ăn với các món ăn tươi ngon" />

                <div class="floating-card">

                    <span>🍲</span>

                    <div>

                        <b>
                            Hôm nay ăn gì?
                        </b>

                        <small>
                            Khám phá 120+ món mới
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </section>


